---
import type { Lang } from '../config';
import { HOME } from '../i18n/home';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<div class="topbar" role="note">
  <p><span class="tb-dot" aria-hidden="true"></span>{HOME[lang].ui.closed}</p>
</div>

<style>
  /* Línea de estado discreta arriba del nav: abierto a roles remotos. Empuja el header (--topbar-h). */
  .topbar {
    position: relative; z-index: 60;
    height: var(--topbar-h);
    display: flex; align-items: flex-end; justify-content: center;
    padding: 0 var(--gutter);
    color: var(--gris-500); text-align: center;
  }
  :global(.hero-dark) .topbar { background: var(--tinta); color: var(--on-dark-2); }
  .topbar p { margin: 0; font: 500 12px/1.4 var(--f-sans); letter-spacing: 0.04em; }
  .tb-dot {
    display: inline-block; width: 6px; height: 6px; border-radius: 50%;
    background: var(--online); margin-right: 8px; vertical-align: 0.12em;
  }
  @media (min-width: 768px) { .topbar p { font-size: var(--t-xs); } }
</style>
