---
import '../../styles/pages.css';
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import Cover from '../Cover.astro';
import Card from '../Card.astro';
import type { Lang } from '../../config';
import { ORDER, PROJECTS, PROJECT_ROUTE } from '../../i18n/portfolio';
import { r } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const P = PROJECTS[lang];
const T = lang === 'es'
  ? { meta: { title: 'Trabajo: casos de growth, CRO e IA | Santiago Cardona', description: 'Casos de growth y CRO (silBe, Radhi Yoga, ILMIN, Undergold, Ideal Team) y productos de IA que construí: Olmo Cotiza, Olmo Métricas y dos skills de Claude.' },
      label: 'Trabajo', title: 'Lo que he *construido*', lead: 'Casos de growth y conversión, y productos de IA que construí yo mismo. En cada uno cuento qué hice, con qué cifras y, cuando se puede, dejo el enlace a la versión en vivo.', view: 'Ver proyecto', cover: 'Portada de' }
  : { meta: { title: 'Work: growth, CRO and AI case studies | Santiago Cardona', description: 'Growth and CRO case studies (silBe, Radhi Yoga, ILMIN, Undergold, Ideal Team) and AI products I built: Olmo Cotiza, Olmo Métricas and two Claude skills.' },
      label: 'Work', title: "What I've *built*", lead: 'Growth and conversion case studies, plus AI products I built myself. Each one shows what I did, the numbers behind it and, where possible, a live link.', view: 'View project', cover: 'Cover for' };
---
<Base lang={lang} dark route="portfolio" title={T.meta.title} description={T.meta.description}>
  <PageHero label={T.label} title={T.title} lead={T.lead} />
  <section class="pf" aria-label={T.label}>
    <div class="wrap">
      <ul class="pf-grid">
        {ORDER.map((id, i) => {
          const p = P[id];
          return (
            <Card href={r(PROJECT_ROUTE[id], lang)} name={p.short ?? p.name} tag={p.tag} figure={p.figure} cursor={T.view}
              vt={`view-transition-name: pj-${id}; view-transition-class: pj`}>
              <Cover slot="media" id={id} lang={lang} alt={`${T.cover} ${p.name}`} eager={i < 4}
                sizes="(min-width: 1200px) 31vw, (min-width: 768px) 46vw, 46vw" />
            </Card>
          );
        })}
      </ul>
    </div>
  </section>
</Base>
<style>
  /* Las 9 tarjetas son iguales a las de la home: 3 por fila en escritorio, 2 en celular y tableta. */
  .pf { padding-block: clamp(56px, 7vw, 104px) var(--sec-y); }
  .pf-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 16px; }
  @media (min-width: 768px) { .pf-grid { gap: 48px 24px; } }
  @media (min-width: 1200px) { .pf-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 56px 28px; } }
</style>
