---
import '../../styles/pages.css';
import { Picture, Image } from 'astro:assets';
import lgSilbe from '../../assets/logos/silbe.png';
import lgVieli from '../../assets/logos/vieli.png';
import lgIlmin from '../../assets/logos/ilmin.png';
import lgSarabe from '../../assets/logos/sarabe.png';
import lgUndergold from '../../assets/logos/undergold.png';
import lgCesde from '../../assets/logos/cesde.png';
import lgBancolombia from '../../assets/logos/bancolombia.png';
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import Btn from '../Btn.astro';
import { LINKS, type Lang } from '../../config';
import { HOME } from '../../i18n/home';
import { IMG } from '../../lib/images';
interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const h = HOME[lang];
const a = h.about;
const T = es
  ? {
      meta: { title: 'Sobre mí: Santiago Cardona Ortiz | Growth, CRO e IA', description: 'Santiago Cardona Ortiz: líder de growth, tecnología y conversión en silBe (2020–2026), cofundador y COO de Vieli (2017–2025) y docente de UX/UI. Medellín, Colombia.' },
      label: 'Sobre mí', right: 'Medellín, Colombia · UTC-5',
      tl: 'Trayectoria', names: 'Con quién he trabajado',
      timeline: [
        { y: '2020–2026', t: 'silBe by Silvy', d: 'Líder de growth, tecnología y conversión. Le reportaba los resultados a la fundadora.', x: 'Me hice cargo del funnel, la tecnología, la conversión y después de todo el marketing, desde el primer lanzamiento (USD 400.000 y 5.000 suscriptores en la primera semana, según Forbes Colombia) hasta la app en FitBudd. Los cambios al funnel llevaron la conversión de cerca de 3 % a 4 %, y diseñé el onboarding, el paywall y la prueba gratis de 7 días con el equipo de desarrollo de FitBudd. La base que ayudé a construir hoy tiene 25.000 suscriptores pagos.' },
        { y: '2017–2025', t: 'Vieli', d: 'Cofundador y COO. Estudio de 30 personas, más de 100 proyectos, todos por referidos. Cerró en 2025.', x: 'Dirigí la operación: la estrategia de cada proyecto, los briefs para los especialistas de pauta y los diseñadores, y la entrega con un equipo remoto en Colombia, Argentina, España y Estados Unidos. Cuando hacía falta, montaba yo mismo las campañas en Meta y Google Ads. También armé lanzamientos y funnels para creadoras que vendían cursos en Hotmart y Kajabi.' },
        { y: '2019–2024', t: 'CESDE', d: 'Docente de UX/UI durante seis años.', x: 'Enseñé a diseñar productos digitales: investigación con usuarios, arquitectura de información, prototipos y pruebas. Enseñar me obligó a explicar con claridad por qué funciona una decisión de diseño, y eso uso hoy al escribirle a un equipo.' },
        { y: '—', t: 'Bancolombia · FIDI', d: 'Prototipo de educación financiera con videos por WhatsApp.', x: 'Diseñé FIDI para enseñar finanzas personales con videos cortos que llegan por WhatsApp, el canal que la gente ya abre todos los días, en lugar de pedirle que descargue otra app.' },
        { y: 'Desde 2025', t: 'Olmo', d: 'Donde construyo productos de IA con Claude Code y Supabase.', x: 'Olmo Cotiza convierte un alcance escrito en una propuesta con link público y PDF; está en producción y se ha usado para propuestas reales. Olmo Métricas es una calculadora gratuita para negocios de suscripción. También publiqué dos skills de código abierto para Claude. Ahora quiero hacerme cargo de una métrica de growth o de CRO dentro de un equipo de producto, de tiempo completo.' },
      ],
    }
  : {
      meta: { title: 'About: Santiago Cardona Ortiz | Growth, CRO & AI', description: 'Santiago Cardona Ortiz: growth, tech and conversion lead at silBe (2020–2026), co-founder and COO of Vieli (2017–2025), and UX/UI instructor. Medellín, Colombia.' },
      label: 'About', right: 'Medellín, Colombia · UTC-5',
      tl: 'Track record', names: "Who I've worked with",
      timeline: [
        { y: '2020–2026', t: 'silBe by Silvy', d: 'Growth, tech and conversion lead, reporting results to the founder.', x: "I owned the funnel, the tech, conversion and later all of marketing, from the first launch (USD 400,000 and 5,000 subscribers in its first week, per Forbes Colombia) to the FitBudd app. My funnel changes took conversion from about 3% to 4%, and I designed the onboarding, paywall and 7-day free trial with FitBudd's development team. The subscription base I helped build is now at 25,000 paying subscribers." },
        { y: '2017–2025', t: 'Vieli', d: 'Co-founder & COO. A 30-person studio, 100+ projects, all from referrals. Closed in 2025.', x: 'I ran operations: the strategy for each project, briefs for the ads specialists and designers, and delivery with a remote team across Colombia, Argentina, Spain and the US. When it was needed, I ran the Meta and Google Ads campaigns myself. I also built launches and funnels for creators selling courses on Hotmart and Kajabi.' },
        { y: '2019–2024', t: 'CESDE', d: 'UX/UI instructor for six years.', x: 'I taught how to design digital products: user research, information architecture, prototyping and testing. Teaching made me explain clearly why a design decision works, which is how I write to a team today.' },
        { y: '—', t: 'Bancolombia · FIDI', d: 'A personal-finance prototype built on short WhatsApp videos.', x: 'I designed FIDI to teach personal finance through short videos sent over WhatsApp, the app people already open every day, instead of asking them to download another one.' },
        { y: 'Since 2025', t: 'Olmo', d: 'Where I build AI products with Claude Code and Supabase.', x: 'Olmo Cotiza turns a written scope into a proposal with a public link and PDF; it is live and has been used for real proposals. Olmo Métricas is a free calculator for subscription businesses. I also published two open-source Claude skills. Next, I want to own a growth or CRO number inside a product team, full time.' },
      ],
    };
// Logos con permiso de uso. Sin logo: nombre en texto. h = alto en px.
const names: { n: string; src?: ImageMetadata; h?: number }[] = [
  { n: 'silBe', src: lgSilbe, h: 40 }, { n: 'Vieli', src: lgVieli, h: 34 }, { n: 'ILMIN', src: lgIlmin, h: 26 },
  { n: 'SaraBe', src: lgSarabe, h: 46 }, { n: 'Undergold', src: lgUndergold, h: 20 }, { n: 'Ideal Team' },
  { n: 'Olmo Métricas' }, { n: 'CESDE', src: lgCesde, h: 28 }, { n: 'Bancolombia', src: lgBancolombia, h: 36 },
];
---
<Base lang={lang} route="about" title={T.meta.title} description={T.meta.description}>
  <PageHero label={T.label} right={T.right} title={a.title} />
  <section class="block">
    <div class="wrap ab">
      <figure class="media-frame ab-photo" data-fade>
        <Picture src={IMG.santiago} alt={a.photoAlt} widths={[400, 700, 1000]} sizes="(min-width: 992px) 40vw, 92vw" formats={['avif']} fallbackFormat="webp" loading="eager" />
      </figure>
      <div>
        <div class="prose" data-fade><p>{a.body}</p></div>
        <div class="ab-links" data-fade>
          <Btn href={LINKS.linkedin} label="LinkedIn" variant="dark" external ariaLabel={`LinkedIn ${h.ui.newTab}`} />
          <Btn href={LINKS.github} label="GitHub" variant="sec" external ariaLabel={`GitHub ${h.ui.newTab}`} />
        </div>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="tl">
    <div class="wrap">
      <div class="labels"><h2 id="tl" class="lbl-h">{T.tl}</h2><span aria-hidden="true">( {T.timeline.length} )</span></div>
      <ol class="rowlist">
        {T.timeline.map((it) => (
          <li data-fade>
            <div><span class="rl-num">{it.y}</span><h3 class="rl-word">{it.t}</h3></div>
            <div class="prose"><p><strong>{it.d}</strong></p><p>{it.x}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="block" aria-labelledby="names">
    <div class="wrap">
      <div class="labels"><h2 id="names" class="lbl-h">{T.names}</h2><span aria-hidden="true">( {names.length} )</span></div>
      <ul class="names" data-fade>
        {names.map((l) => (
          <li>{l.src ? <Image src={l.src} alt={l.n} height={l.h! * 2} format="webp" loading="lazy" style={`height:${l.h}px`} /> : <span>{l.n}</span>}</li>
        ))}
      </ul>
    </div>
  </section>
</Base>
<style>
  .lbl-h { font: inherit; }
  .ab { display: grid; gap: 40px; }
  @media (min-width: 992px) { .ab { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 30px; align-items: start; } }
  .ab-photo { aspect-ratio: 4 / 5; max-width: 560px; }
  .ab-photo :global(img) { object-position: 50% 20%; }
  .ab-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
  .names { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 28px; }
  @media (min-width: 768px) { .names { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .names li { display: grid; place-items: center; min-height: 120px; padding: 20px; border-radius: var(--r-img); background: var(--blanco); }
  /* Todos los logos en silueta oscura para que pesen parejo, sin importar el color original */
  .names :global(img) { width: auto; max-width: 100%; object-fit: contain; filter: brightness(0); opacity: .6; transition: opacity .3s; }
  .names li:hover :global(img) { opacity: .9; }
  .names span { font: 700 clamp(20px, 2vw, 26px)/1.1 var(--f-sans); letter-spacing: -0.04em; color: var(--tinta); opacity: .6; text-align: center; }
</style>
