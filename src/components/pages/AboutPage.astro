---
import '../../styles/pages.css';
import { Picture, Image } from 'astro:assets';
import lgSilbe from '../../assets/logos/silbe.png';
import lgVieli from '../../assets/logos/vieli.png';
import lgIlmin from '../../assets/logos/ilmin.png';
import lgSarabe from '../../assets/logos/sarabe.png';
import lgUndergold from '../../assets/logos/undergold.png';
import lgCesde from '../../assets/logos/cesde.png';
import lgBancolombia from '../../assets/logos/bancolombia.png';
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import Btn from '../Btn.astro';
import { LINKS, type Lang } from '../../config';
import { HOME } from '../../i18n/home';
import { IMG } from '../../lib/images';
interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const h = HOME[lang];
const a = h.about;
const T = es
  ? {
      meta: { title: 'Sobre mí: Santiago Cardona Ortiz | Olmo', description: 'Santiago Cardona Ortiz: cofundador y COO de Vieli (2017–2025), docente de UX/UI en CESDE durante 6 años y asesor independiente desde Medellín.' },
      label: 'Sobre mí', right: 'Medellín, Colombia',
      tl: 'Trayectoria', names: 'Con quién he trabajado',
      timeline: [
        { y: '2017–2025', t: 'Vieli', d: 'Cofundador y COO. Estudio de 30 personas, más de 100 proyectos, todos por referidos.', x: 'Definía la estrategia de cada cliente, presentaba presupuestos y resultados a los dueños y la convertía en briefs para los especialistas de pauta y los diseñadores. Cuando un cliente no podía esperar, montaba yo mismo las campañas en Meta y Google Ads. También armé lanzamientos y funnels para creadoras de contenido con 845.000 a 1 millón de seguidores que vendían cursos en Hotmart y Kajabi. El equipo trabajaba remoto desde Colombia, Argentina, España y Estados Unidos.' },
        { y: '2020–2026', t: 'silBe', d: 'Líder de growth y marketing: funnel, conversión, app y suscripción.', x: 'Lideré el marketing desde el primer lanzamiento, que logró USD 400.000 y 5.000 suscriptores en la primera semana (Forbes, 2021), hasta una app con 25.000 suscriptores pagos. Definí los canales y la oferta en cinco mercados (Colombia, Estados Unidos, Medio Oriente, Australia y España), medí cada venta por canal y por creador, y con pruebas A/B en el checkout la conversión pasó de 3 % a 4 %.' },
        { y: '2019–2024', t: 'CESDE', d: 'Docente de UX/UI (diseño de interfaces y experiencia de usuario).', x: 'Durante seis años enseñé a diseñar productos digitales: investigación con usuarios, arquitectura de información, prototipos y pruebas. Enseñar me obligó a explicar con claridad por qué una decisión de diseño funciona.' },
        { y: '—', t: 'Bancolombia · FIDI', d: 'Prototipo de educación financiera con videos por WhatsApp.', x: 'Diseñé FIDI para enseñar finanzas personales con videos cortos que llegan por WhatsApp, el canal que la gente ya abre todos los días, en lugar de pedirle que descargue otra app.' },
        { y: 'Desde 2025', t: 'Olmo', d: 'Asesoría independiente.', x: 'Trabajo solo y directamente con los dueños y equipos de marcas que ya venden online. Asesoro en funnels, producto, sistemas con IA y web, y me quedo hasta que se note en los números. También construí Olmo Métricas, una calculadora gratuita para negocios de suscripción, y Olmo Cotiza, que convierte un alcance escrito en una propuesta lista para enviar y ya la usan clientes reales.' },
      ],
    }
  : {
      meta: { title: 'About: Santiago Cardona Ortiz | Olmo', description: 'Santiago Cardona Ortiz: co-founder and COO of Vieli (2017–2025), UX/UI instructor at CESDE for six years, and independent advisor based in Medellín.' },
      label: 'About', right: 'Medellín, Colombia',
      tl: 'Track record', names: "Who I've worked with",
      timeline: [
        { y: '2017–2025', t: 'Vieli', d: 'Co-founder & COO. A 30-person studio, 100+ projects, all from referrals.', x: 'I set the strategy for every client, presented budgets and results to the owners, and turned the plan into briefs for the ads specialists and designers. When a client couldn\'t wait, I ran the Meta and Google Ads campaigns myself. I also built launches and funnels for creators with 845,000 to 1 million followers selling courses on Hotmart and Kajabi. The team worked remotely from Colombia, Argentina, Spain and the US.' },
        { y: '2020–2026', t: 'silBe', d: 'Growth and marketing lead: funnel, conversion, app and subscription.', x: 'I led marketing from the first launch, which brought in USD 400,000 and 5,000 subscribers in its first week (Forbes, 2021), to an app with 25,000 paying subscribers. I set the channels and the offer in five markets (Colombia, the US, the Middle East, Australia and Spain), tracked every sale by channel and by creator, and checkout A/B tests lifted conversion from 3% to 4%.' },
        { y: '2019–2024', t: 'CESDE', d: 'UX/UI instructor.', x: 'For six years I taught how to design digital products: user research, information architecture, prototyping and testing. Teaching made me explain clearly why a design decision works.' },
        { y: '—', t: 'Bancolombia · FIDI', d: 'A personal-finance prototype built on short WhatsApp videos.', x: 'I designed FIDI to teach personal finance through short videos sent over WhatsApp, the app people already open every day, instead of asking them to download another one.' },
        { y: 'Since 2025', t: 'Olmo', d: 'Independent advisory.', x: 'I work on my own, directly with the owners and teams of brands that already sell online. I advise on funnels, product, AI-powered systems and web, and I stay until it shows in the numbers. I also built Olmo Métricas, a free calculator for subscription businesses, and Olmo Cotiza, which turns a written scope into a proposal ready to send and is used by real clients.' },
      ],
    };
// Logos con permiso de uso. Sin logo: nombre en texto. h = alto en px.
const names: { n: string; src?: ImageMetadata; h?: number }[] = [
  { n: 'silBe', src: lgSilbe, h: 40 }, { n: 'Vieli', src: lgVieli, h: 34 }, { n: 'ILMIN', src: lgIlmin, h: 26 },
  { n: 'SaraBe', src: lgSarabe, h: 46 }, { n: 'Undergold', src: lgUndergold, h: 20 }, { n: 'Ideal Team' },
  { n: 'Olmo Métricas' }, { n: 'CESDE', src: lgCesde, h: 28 }, { n: 'Bancolombia', src: lgBancolombia, h: 36 },
];
---
<Base lang={lang} route="about" title={T.meta.title} description={T.meta.description}>
  <PageHero label={T.label} right={T.right} title={a.title} />
  <section class="block">
    <div class="wrap ab">
      <figure class="media-frame ab-photo" data-fade>
        <Picture src={IMG.santiago} alt={a.photoAlt} widths={[400, 700, 1000]} sizes="(min-width: 992px) 40vw, 92vw" formats={['avif']} fallbackFormat="webp" loading="eager" />
      </figure>
      <div>
        <div class="prose" data-fade><p>{a.body}</p></div>
        <div class="ab-links" data-fade>
          <Btn href={LINKS.linkedin} label="LinkedIn" variant="dark" external ariaLabel={`LinkedIn ${h.ui.newTab}`} />
          <Btn href={LINKS.github} label="GitHub" variant="sec" external ariaLabel={`GitHub ${h.ui.newTab}`} />
        </div>
      </div>
    </div>
  </section>

  <section class="block" aria-labelledby="tl">
    <div class="wrap">
      <div class="labels"><h2 id="tl" class="lbl-h">{T.tl}</h2><span aria-hidden="true">( {T.timeline.length} )</span></div>
      <ol class="rowlist">
        {T.timeline.map((it) => (
          <li data-fade>
            <div><span class="rl-num">{it.y}</span><h3 class="rl-word">{it.t}</h3></div>
            <div class="prose"><p><strong>{it.d}</strong></p><p>{it.x}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="block" aria-labelledby="names">
    <div class="wrap">
      <div class="labels"><h2 id="names" class="lbl-h">{T.names}</h2><span aria-hidden="true">( {names.length} )</span></div>
      <ul class="names" data-fade>
        {names.map((l) => (
          <li>{l.src ? <Image src={l.src} alt={l.n} height={l.h! * 2} format="webp" loading="lazy" style={`height:${l.h}px`} /> : <span>{l.n}</span>}</li>
        ))}
      </ul>
    </div>
  </section>
</Base>
<style>
  .lbl-h { font: inherit; }
  .ab { display: grid; gap: 40px; }
  @media (min-width: 992px) { .ab { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 30px; align-items: start; } }
  .ab-photo { aspect-ratio: 4 / 5; max-width: 560px; }
  .ab-photo :global(img) { object-position: 50% 20%; }
  .ab-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
  .names { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 28px; }
  @media (min-width: 768px) { .names { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .names li { display: grid; place-items: center; min-height: 120px; padding: 20px; border-radius: var(--r-img); background: var(--blanco); }
  /* Todos los logos en silueta oscura para que pesen parejo, sin importar el color original */
  .names :global(img) { width: auto; max-width: 100%; object-fit: contain; filter: brightness(0); opacity: .6; transition: opacity .3s; }
  .names li:hover :global(img) { opacity: .9; }
  .names span { font: 700 clamp(20px, 2vw, 26px)/1.1 var(--f-sans); letter-spacing: -0.04em; color: var(--tinta); opacity: .6; text-align: center; }
</style>
