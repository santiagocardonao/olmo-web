---
import '../../styles/pages.css';
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import { EMAIL, type Lang } from '../../config';
interface Props { lang: Lang; kind: 'terms' | 'privacy' }
const { lang, kind } = Astro.props;
const es = lang === 'es';
type Sec = { h: string; p: string };
const terms: { title: string; meta: string; secs: Sec[] } = es
  ? { title: 'Términos de uso', meta: 'Términos de uso del portafolio personal de Santiago Cardona Ortiz.', secs: [
      { h: 'Qué es este sitio', p: `Es el portafolio personal de Santiago Cardona Ortiz, desde Medellín, Colombia. Muestra mi trabajo y mis proyectos. Contacto: ${EMAIL}.` },
      { h: 'Contenido', p: 'El contenido es informativo. Las cifras marcadas como dato interno vienen de los equipos con los que trabajé; las de prensa citan su fuente.' },
      { h: 'Marcas de terceros', p: 'Los nombres, logos y capturas de otras marcas pertenecen a sus dueños y aparecen con su permiso para mostrar el trabajo que hice con ellas.' },
      { h: 'Código y herramientas', p: 'Las herramientas y skills de código abierto tienen su propia licencia en GitHub. El resto del contenido es mío y no se puede copiar sin permiso.' },
      { h: 'Ley aplicable', p: 'Estos términos se rigen por las leyes de Colombia.' },
    ] }
  : { title: 'Terms of use', meta: 'Terms of use for the personal portfolio of Santiago Cardona Ortiz.', secs: [
      { h: 'What this site is', p: `The personal portfolio of Santiago Cardona Ortiz, based in Medellín, Colombia. It shows my work and projects. Contact: ${EMAIL}.` },
      { h: 'Content', p: 'Content is for information only. Figures labeled internal data come from the teams I worked with; press figures cite their source.' },
      { h: 'Third-party brands', p: 'Names, logos and screenshots of other brands belong to their owners and appear with their permission to show the work I did with them.' },
      { h: 'Code and tools', p: 'The open-source tools and skills carry their own license on GitHub. The rest of the content is mine and may not be copied without permission.' },
      { h: 'Governing law', p: 'These terms are governed by the laws of Colombia.' },
    ] };
const privacy: typeof terms = es
  ? { title: 'Política de privacidad', meta: 'Cómo trato los datos personales de quienes visitan este portafolio o me escriben.', secs: [
      { h: 'Responsable', p: `Santiago Cardona Ortiz (Olmo), Medellín, Colombia. Contacto: ${EMAIL}.` },
      { h: 'Qué datos recojo', p: 'Este sitio no tiene formularios. Si me escribes, uso lo que me cuentas solo para responderte.' },
      { h: 'Analítica', p: 'Uso Google Analytics 4, cargado a través de Google Tag Manager, para saber cuántas personas visitan el sitio y qué páginas leen. Google Analytics usa cookies y no guarda tu dirección IP. También uso PostHog para ver de forma agregada cómo se navega el sitio: páginas vistas y clics. No uso estos datos para identificarte ni para mostrarte publicidad.' },
      { h: 'Tus derechos', p: `Según la Ley 1581 de 2012, puedes conocer, actualizar, corregir o pedir que borre tus datos personales cuando quieras. Escríbeme a ${EMAIL} y te respondo en máximo 15 días hábiles.` },
      { h: 'Conservación de los datos', p: 'Guardo tus mensajes solo mientras sean útiles para la conversación. Después los borro.' },
      { h: 'Cambios a esta política', p: 'Si cambio esta política, publico la nueva versión en esta misma página.' },
    ] }
  : { title: 'Privacy policy', meta: 'How I handle the personal data of people who visit this portfolio or email me.', secs: [
      { h: 'Controller', p: `Santiago Cardona Ortiz (Olmo), Medellín, Colombia. Contact: ${EMAIL}.` },
      { h: 'What data I collect', p: "This site has no forms. If you email me, I only use what you tell me to reply." },
      { h: 'Analytics', p: 'I use Google Analytics 4, loaded through Google Tag Manager, to see how many people visit the site and which pages they read. Google Analytics uses cookies and does not store your IP address. I also use PostHog to see, in aggregate, how people move through the site: page views and clicks. I don\'t use this data to identify you or to show you ads.' },
      { h: 'Your rights', p: `Under Colombian law (Ley 1581 de 2012) you can access, update, correct or ask me to delete your personal data at any time. Email ${EMAIL} and I'll reply within 15 business days.` },
      { h: 'Data retention', p: 'I keep your messages only while they are useful to the conversation. After that, I delete them.' },
      { h: 'Changes to this policy', p: 'If I change this policy, I will publish the new version on this page.' },
    ] };
const d = kind === 'terms' ? terms : privacy;
---
<Base lang={lang} route={kind} title={`${d.title} | Olmo · Santiago Cardona`} description={d.meta}>
  <PageHero label={es ? 'Legal' : 'Legal'} title={d.title} />
  <section class="block">
    <div class="wrap">
      <div class="prose legal">
        {d.secs.map((s, i) => (
          <Fragment>
            <h2>{i + 1}. {s.h}</h2>
            <p>{s.p}</p>
          </Fragment>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .legal { max-width: 48em; }
  .legal h2:first-child { margin-top: 0; }
</style>
