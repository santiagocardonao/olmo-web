---
import '../../styles/pages.css';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import Card from '../Card.astro';
import Cover from '../Cover.astro';
import type { Lang } from '../../config';
import { HOME } from '../../i18n/home';
import { IMG } from '../../lib/images';
interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const ui = HOME[lang].ui;
const GH = 'https://github.com/santiagocardonao/';
const tools = [
  {
    name: 'Olmo Métricas',
    text: es
      ? 'Calculadora gratuita para negocios de suscripción: MRR, CLTV, CAC, LTV:CAC y punto de equilibrio, en 4 monedas y 2 idiomas, con links para compartir. Los cálculos corren en Postgres.'
      : 'A free calculator for subscription businesses: MRR, CLTV, CAC, LTV:CAC and break-even, in 4 currencies and 2 languages, with shareable links. The math runs in Postgres.',
    live: 'https://metricas.olmo.agency', liveLabel: 'metricas.olmo.agency', repo: 'olmo-metricas', cover: 'metricas' as const,
    img: IMG.metricas, alt: es ? 'Calculadora Olmo Métricas con un cálculo de ingresos mensuales' : 'Olmo Métricas calculator showing a monthly revenue calculation',
  },
  {
    name: 'Olmo Cotiza',
    text: es
      ? 'Producto de IA en producción: de un alcance escrito a una propuesta con link público y PDF, en español o inglés. Claude (API de Anthropic) estructura el alcance y una Edge Function de Supabase lo guarda. La demo pide un correo y tiene límites de uso.'
      : 'A production AI product: from a written scope to a proposal with a public link and PDF, in English or Spanish. Claude (Anthropic API) structures the scope and a Supabase Edge Function stores it. The demo asks for an email and is rate-limited.',
    live: 'https://cotiza.olmo.agency/demo', liveLabel: 'cotiza.olmo.agency/demo', repo: 'olmo-cotiza', cover: 'cotiza' as const,
    img: IMG.cotiza, alt: es ? 'Demo de Olmo Cotiza con una lista de cotizaciones de ejemplo' : 'Olmo Cotiza demo with a list of sample quotes',
  },
  {
    name: 'Steady',
    text: es
      ? 'Registro de gimnasio hecho para un usuario real, mi papá. React y Supabase, PWA instalable.'
      : 'A gym log built for one real user, my dad. React and Supabase, installable PWA.',
    live: 'https://steady-gym.lovable.app', liveLabel: 'steady-gym.lovable.app', repo: 'steady',
    img: IMG.steady, alt: es ? 'Pantalla de inicio de la app Steady' : 'Steady app sign-in screen', phone: true,
  },
  {
    name: 'Español natural',
    text: es
      ? 'Skill de Claude para que la IA escriba en español nativo, no en traducción del inglés.'
      : 'A Claude skill that makes AI write native Spanish, not translated English.',
    repo: 'espanol-natural', cover: 'espanol' as const,
  },
  {
    name: 'Design System Adherence',
    text: es
      ? 'Skill que revisa si un entregable sigue de verdad su design system. La severidad se calcula, no se juzga.'
      : 'A skill that checks whether a deliverable really follows its design system. Severity is calculated, not judged.',
    repo: 'design-system-adherence', cover: 'dsa' as const,
  },
];
const T = es
  ? { meta: { title: 'Productos de IA: Olmo Cotiza, Métricas y skills de Claude | Santiago Cardona', description: 'Productos y herramientas que construí con Claude Code y Supabase: Olmo Cotiza, Olmo Métricas, Steady y dos skills de Claude. Código abierto en GitHub.' }, label: 'IA', title: 'Lo que *construyo* con IA', lead: 'Productos y herramientas que construí yo, de la idea a producción, con Claude Code y Supabase. El código de todos está en GitHub.', open: 'Abrir', code: 'Código en GitHub' }
  : { meta: { title: 'AI builds: Olmo Cotiza, Métricas and Claude skills | Santiago Cardona', description: 'Products and tools I built with Claude Code and Supabase: Olmo Cotiza, Olmo Métricas, Steady and two Claude skills. Open source on GitHub.' }, label: 'AI builds', title: 'What I *build* with AI', lead: 'Products and tools I built myself, from idea to production, with Claude Code and Supabase. The code for all of them is on GitHub.', open: 'Open', code: 'Code on GitHub' };
---
<Base lang={lang} dark route="tools" title={T.meta.title} description={T.meta.description}>
  <PageHero label={T.label} title={T.title} lead={T.lead} />
  <section class="tl-sec" aria-label={T.label}>
    <div class="wrap">
      <ul class="tools">
        {tools.map((t, i) => (
          <Card href={t.live ?? GH + t.repo} name={t.name} text={t.text} external newTab={ui.newTab}>
            {t.cover ? (
              <Cover slot="media" id={t.cover} lang={lang} alt={t.alt ?? t.name} eager={i < 2} sizes="(min-width: 1200px) 19vw, (min-width: 768px) 46vw, 72vw" />
            ) : (
              <div slot="media" class="tool-phone">
                <Picture src={t.img!} alt={t.alt!} widths={[400, 700]} sizes="(min-width: 1200px) 12vw, 40vw" formats={['avif']} fallbackFormat="webp" loading="lazy" />
              </div>
            )}
            <p class="tool-links">
              {t.live && <a class="tlink under" href={t.live} target="_blank" rel="noopener">{t.liveLabel} ↗<span class="sr-only"> {ui.newTab}</span></a>}
              <a class="tlink under" href={GH + t.repo} target="_blank" rel="noopener">{T.code} ↗<span class="sr-only"> {ui.newTab}</span></a>
            </p>
          </Card>
        ))}
      </ul>
    </div>
  </section>
</Base>
<style>
  /* Misma tarjeta que la home y Trabajo: 5 en una fila en escritorio, 2 por fila en tableta, fila deslizable en celular. */
  .tl-sec { padding-block: clamp(56px, 7vw, 104px) var(--sec-y); }
  .tools { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px 24px; }
  @media (min-width: 1200px) { .tools { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 20px; } }
  @media (max-width: 767px) {
    .tools {
      display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
      margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter);
    }
    .tools::-webkit-scrollbar { display: none; }
    .tools > :global(li) { flex: none; width: 72vw; scroll-snap-align: start; }
  }
  .tool-phone { width: 100%; height: 100%; display: grid; place-items: center; padding: 10%; background: #ECECEF; }
  .tool-phone :global(img) { width: auto !important; height: 100% !important; border-radius: 18px; border: 5px solid #111; object-fit: cover; aspect-ratio: 860 / 1560; }
  .tool-links { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 12px; font-size: 14px; }
</style>
