---
/**
 * Hero de la home: "túnel en perspectiva". Las portadas del portafolio viajan hacia la cámara
 * mientras se hace scroll por una sección alta con escenario fijo (sticky).
 * Adaptado de un componente React + framer-motion a Astro + JS sin dependencias.
 * No hay wheel hijacking: el progreso sale del scroll normal, así que funciona igual con trackpad, rueda y touch.
 */
import Cover from '../Cover.astro';
import { ORDER, PROJECTS, PROJECT_ROUTE } from '../../i18n/portfolio';
import { r } from '../../i18n/routes';
import type { Lang } from '../../config';
import { HOME } from '../../i18n/home';
import { emph } from '../../lib/util';
interface Props { lang: Lang }
const { lang } = Astro.props;
const h = HOME[lang].hero;
const P = PROJECTS[lang];
const name = h.eyebrow.split('·')[0].trim();
const role = h.eyebrow.split('·').slice(1).join('·').trim();
---
<section class="tun band-dark" aria-labelledby="hero-h1" data-dark data-tun>
  <div class="tun-stage">
    <div class="tun-glow" aria-hidden="true"></div>
    <div class="tun-ring tun-ring-1" aria-hidden="true"></div>
    <div class="tun-ring tun-ring-2" aria-hidden="true"></div>

    <div class="tun-plane" role="group" aria-label={lang === 'es' ? 'Proyectos' : 'Projects'}>
      {ORDER.map((id, i) => (
        <a class="tc" href={r(PROJECT_ROUTE[id], lang)} data-tc={i}>
          <span class="tc-card">
            <Cover id={id} lang={lang} alt={P[id].name} sizes="(min-width: 768px) 270px, 180px" eager={i < 3} />
            <span class="tc-label">{P[id].name}</span>
          </span>
        </a>
      ))}
    </div>

    <div class="wrap tun-copy" data-tun-copy>
      <p class="tun-eyebrow">{role}</p>
      <p class="tun-name">{name}<span class="hn-dot" aria-hidden="true">.</span></p>
      <h1 id="hero-h1" class="tun-h1" set:html={emph(h.h1)} />
      <p class="tun-sub">{h.sub}</p>
    </div>

    <p class="tun-prompt" aria-hidden="true" data-tun-prompt>
      <span>{lang === 'es' ? 'Haz scroll' : 'Scroll to explore'}</span>
      <i></i>
    </p>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-tun]');
  if (root) {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-tc]'));
    const copy = root.querySelector<HTMLElement>('[data-tun-copy]')!;
    const prompt = root.querySelector<HTMLElement>('[data-tun-prompt]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const total = cards.length;

    // Posición fija de cada portada en el túnel: ángulo áureo para que no se amontonen.
    const data = cards.map((_, i) => {
      const a = i * 137.5 * (Math.PI / 180);
      return {
        cos: Math.cos(a), sin: Math.sin(a),
        rx: 0.28 + (i % 3) * 0.08,
        ry: 0.26 + (i % 2) * 0.09,
        rot: (i % 2 === 0 ? 1 : -1) * (3 + (i % 5) * 2),
      };
    });

    let W = innerWidth, H = innerHeight, mobile = W < 768;
    const onResize = () => { W = innerWidth; H = innerHeight; mobile = W < 768; };
    addEventListener('resize', onResize, { passive: true });

    // Progreso por scroll (0 → 1 a lo largo de la sección alta) + puntero, ambos suavizados.
    let target = 0, prog = 0, px = 0, py = 0, tpx = 0, tpy = 0;
    const readScroll = () => {
      const b = root.getBoundingClientRect();
      const span = b.height - H;
      target = span > 0 ? Math.min(1, Math.max(0, -b.top / span)) : 0;
    };
    addEventListener('scroll', readScroll, { passive: true });
    if (!reduce && matchMedia('(pointer: fine)').matches) {
      addEventListener('pointermove', (e) => {
        tpx = (e.clientX / W - 0.5) * 2;
        tpy = (e.clientY / H - 0.5) * 2;
      }, { passive: true });
    }

    const clamp = (v: number) => Math.min(1, Math.max(0, v));
    // Rampa por tramos, como useTransform con varios puntos.
    const ramp = (t: number, xs: number[], ys: number[]) => {
      if (t <= xs[0]) return ys[0];
      for (let k = 1; k < xs.length; k++) {
        if (t <= xs[k]) return ys[k - 1] + ((t - xs[k - 1]) / (xs[k] - xs[k - 1])) * (ys[k] - ys[k - 1]);
      }
      return ys[ys.length - 1];
    };

    const STAGGER = 0.55;
    // En reposo ya se ven portadas al fondo: el túnel arranca un poco "adelantado".
    const HEAD = 0.2;

    const render = () => {
      const p = HEAD + prog * (1 - HEAD);
      const farZ = mobile ? -1200 : -1700;
      const nearZ = mobile ? 350 : 500;
      const pan = mobile ? 20 : 45;
      const SPREAD = mobile ? 0.8 : 1.5;
      const cw = mobile ? Math.max(130, Math.min(180, W * 0.38)) : Math.max(180, Math.min(270, W * 0.18));

      cards.forEach((el, i) => {
        const d = data[i];
        const start = (i / total) * (1 - STAGGER);
        const lp = clamp((p - start) / STAGGER);
        const z = farZ + (nearZ - farZ) * lp;
        const op = ramp(lp, [0, 0.18, 0.82, 0.98], [0, 1, 1, 0]);
        // Al fondo la perspectiva junta todo en el centro: se empujan hacia afuera y se van cerrando al acercarse.
        const out = 1 + SPREAD * (1 - lp);
        const x = d.cos * W * d.rx * out - px * pan;
        const y = d.sin * H * d.ry * out - py * pan;
        el.style.width = `${cw}px`;
        el.style.opacity = op.toFixed(3);
        el.style.visibility = op < 0.02 ? 'hidden' : 'visible';
        el.style.transform = `translate3d(calc(-50% + ${x.toFixed(1)}px), calc(-50% + ${y.toFixed(1)}px), ${z.toFixed(1)}px) rotateZ(${d.rot}deg)`;
      });

      // El texto entra completo, crece un poco y se apaga en la primera mitad del viaje.
      const s = ramp(prog, [0, 0.5], [1, 1.25]);
      copy.style.transform = `scale(${s.toFixed(3)})`;
      copy.style.opacity = ramp(prog, [0, 0.15, 0.45], [1, 1, 0]).toFixed(3);
      prompt.style.opacity = ramp(prog, [0, 0.08], [1, 0]).toFixed(3);
    };

    if (reduce) {
      // Sin movimiento: una sola foto del túnel, sin sección alta.
      root.classList.add('is-static');
      prog = 0.25;
      render();
      copy.style.transform = 'none';
      copy.style.opacity = '1';
      addEventListener('resize', render, { passive: true });
    } else {
      readScroll();
      prog = target;
      // El bucle solo corre mientras la sección está en pantalla o aún no ha llegado a su posición.
      let inView = true, running = false;
      const tick = () => {
        prog += (target - prog) * 0.09;
        px += (tpx - px) * 0.06;
        py += (tpy - py) * 0.06;
        render();
        const settled = Math.abs(target - prog) < 0.0005 && Math.abs(tpx - px) < 0.001 && Math.abs(tpy - py) < 0.001;
        if (inView || !settled) requestAnimationFrame(tick); else running = false;
      };
      const start = () => { if (!running) { running = true; requestAnimationFrame(tick); } };
      new IntersectionObserver(([e]) => { inView = e.isIntersecting; if (inView) start(); }).observe(root);
      addEventListener('scroll', start, { passive: true });
      start();
    }
  }
</script>

<style>
  /* Sección alta: el escenario queda fijo mientras se recorre. */
  .tun { position: relative; height: 320svh; background: var(--tinta, #111); }
  .tun.is-static { height: auto; }
  .tun-stage {
    position: sticky; top: 0; height: 100svh; overflow: hidden; isolation: isolate;
    display: grid; place-items: center;
    perspective: 1200px; transform-style: preserve-3d;
  }
  @media (max-width: 767px) { .tun-stage { perspective: 900px; } }
  .tun.is-static .tun-stage { position: relative; }

  .tun-glow {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(circle at center, rgba(109, 40, 217, .22) 0%, transparent 70%),
      radial-gradient(rgba(255, 255, 255, .07) 1px, transparent 1px) 0 0 / 28px 28px;
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 60%, transparent 100%);
            mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, #000 60%, transparent 100%);
  }
  .tun-ring { position: absolute; border-radius: 50%; pointer-events: none; }
  .tun-ring-1 { width: 48vmin; height: 48vmin; border: 1px solid rgba(139, 92, 246, .18); }
  .tun-ring-2 { width: 76vmin; height: 76vmin; border: 1px dashed rgba(255, 255, 255, .1); }

  /* ---------- Portadas ---------- */
  .tun-plane { position: absolute; inset: 0; transform-style: preserve-3d; }
  .tc {
    position: absolute; left: 50%; top: 50%; display: block; aspect-ratio: 4 / 5;
    will-change: transform, opacity; opacity: 0; visibility: hidden;
  }
  .tc-card {
    position: relative; display: block; width: 100%; height: 100%; overflow: hidden;
    border-radius: 16px; background: #1d1d1f;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, .8);
    outline: 1px solid rgba(255, 255, 255, .14); outline-offset: -1px;
    transition: outline-color .4s var(--ease-out), box-shadow .4s var(--ease-out);
  }
  .tc-card :global(picture), .tc-card :global(img), .tc-card :global(svg), .tc-card :global(.cover-ph) { width: 100%; height: 100%; }
  .tc-card :global(img) { object-fit: cover; transition: transform .7s var(--ease-out); }
  .tc-card::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to top, rgba(0, 0, 0, .8), rgba(0, 0, 0, .1) 45%, transparent);
  }
  .tc-label {
    position: absolute; left: 16px; right: 16px; bottom: 14px; z-index: 1;
    font: 500 12px/1.3 var(--f-sans); letter-spacing: .14em; text-transform: uppercase; color: #fff;
  }
  @media (hover: hover) and (pointer: fine) {
    .tc:hover .tc-card { outline-color: rgba(139, 92, 246, .8); box-shadow: 0 30px 70px -20px rgba(109, 40, 217, .45); }
    .tc:hover .tc-card :global(img) { transform: scale(1.08); }
  }
  .tc:focus-visible { outline: none; }
  .tc:focus-visible .tc-card { outline: 2px solid var(--on-dark); outline-offset: 3px; }

  /* ---------- Texto ---------- */
  .tun-copy { position: relative; z-index: 2; text-align: center; pointer-events: none; will-change: transform, opacity; }
  .tun-eyebrow { font: 500 var(--t-xs)/1.4 var(--f-sans); letter-spacing: .12em; text-transform: uppercase; color: #fff; }
  .tun-name {
    margin-top: clamp(8px, 1.4vw, 20px);
    font: 400 clamp(56px, 9vw, 168px)/0.9 var(--f-logo); letter-spacing: -0.04em;
    color: var(--on-dark); text-shadow: 0 2px 40px rgba(17, 17, 17, .7);
  }
  @media (min-width: 1024px) { .tun-name { white-space: nowrap; } }
  .hn-dot { color: var(--violeta); }
  .tun-h1 {
    margin: clamp(18px, 2.2vw, 32px) auto 0; max-width: 34ch;
    font: 500 clamp(20px, 2vw, 28px)/1.3 var(--f-sans); letter-spacing: -0.02em;
    color: var(--on-dark); text-wrap: balance; text-shadow: 0 2px 24px rgba(17, 17, 17, .8);
  }
  .tun-h1 :global(em.s) { color: inherit; }
  .tun-sub {
    margin: 14px auto 0; max-width: 52ch;
    font: 400 var(--t-base)/1.55 var(--f-sans); color: #fff; text-wrap: pretty;
    text-shadow: 0 2px 20px rgba(17, 17, 17, .9);
  }

  .tun-prompt {
    position: absolute; bottom: 28px; left: 0; right: 0; z-index: 3;
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    font: 500 11px/1 var(--f-sans); letter-spacing: .3em; text-transform: uppercase; color: #ffffffb3;
    pointer-events: none;
  }
  .tun-prompt i { width: 1px; height: 24px; background: linear-gradient(var(--violeta), transparent); }
  .tun.is-static .tun-prompt { display: none; }
</style>
