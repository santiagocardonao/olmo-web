---
import Btn from '../Btn.astro';
import Cover from '../Cover.astro';
import { ORDER, PROJECTS, PROJECT_ROUTE } from '../../i18n/portfolio';
import { r } from '../../i18n/routes';
import { LINKS, EMAIL, type Lang } from '../../config';
import { HOME } from '../../i18n/home';
import { emph } from '../../lib/util';
interface Props { lang: Lang }
const { lang } = Astro.props;
const h = HOME[lang].hero;
const ui = HOME[lang].ui;
// La tira usa las mismas portadas, nombres y enlaces del portafolio.
const P = PROJECTS[lang];
---
<section class="hero" aria-labelledby="hero-h1">
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <p class="hero-eyebrow" data-hero>{h.eyebrow}</p>
      <h1 id="hero-h1" class="hero-h1" data-hero set:html={emph(h.h1)} />
      <p class="hero-sub support" data-hero>{h.sub}</p>
    </div>

    <ul class="hero-stats" data-hero aria-label={lang === 'es' ? 'Resultados' : 'Results'}>
      {h.stats.map((s) => (
        <li><span class="hs-v tnum">{s.v}</span><span class="hs-k">{s.k}</span></li>
      ))}
    </ul>
    <p class="hero-press small" data-hero>
      <a class="tlink" href={LINKS.forbes} target="_blank" rel="noopener">{h.press} ↗<span class="sr-only"> {ui.newTab}</span></a>
    </p>

    <div class="hero-actions" data-hero>
      <div class="hero-btns">
        <Btn href={`mailto:${EMAIL}`} label={h.primary} ariaLabel={ui.ctaLabel} data-cta="email-hero" />
        <Btn href={LINKS.linkedin} label="LinkedIn" variant="sec" external ariaLabel={h.linkedinLabel} data-cta="linkedin-hero" />
      </div>
      <p class="hero-social small">
        <a class="tlink" href={r('portfolio', lang)}>{h.secondary} →</a>
        <a class="tlink" href={LINKS.github} target="_blank" rel="noopener" aria-label={h.githubLabel}>GitHub ↗</a>
      </p>
    </div>

    <nav class="strip" aria-label={lang === 'es' ? 'Portafolio' : 'Portfolio'} data-hero>
      <ul>
        {ORDER.filter((id) => !['metricas', 'espanol', 'dsa'].includes(id)).map((id, i) => (
          <li>
            <a class="thumb" href={r(PROJECT_ROUTE[id], lang)} aria-label={P[id].name}>
              <span class="thumb-img">
                <Cover id={id} lang={lang} alt="" sizes="(min-width: 1200px) 210px, 140px" eager={i < 6} />
              </span>
              <span class="thumb-label" aria-hidden="true">{P[id].name}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--header-h) + clamp(16px, 4vw, 48px));
    padding-bottom: clamp(32px, 4vw, 60px);
  }
  @media (min-width: 1200px) {
    .hero { min-height: min(100svh, 940px); display: flex; flex-direction: column; justify-content: flex-end; }
  }
  .hero-copy { max-width: 1100px; }
  .hero-eyebrow {
    font: 600 12px/1.4 var(--f-sans); letter-spacing: .18em; text-transform: uppercase;
    color: var(--violeta); margin-bottom: 18px;
  }
  .hero-h1 {
    font: 700 clamp(36px, 5.4vw, 80px)/1.02 var(--f-sans);
    letter-spacing: -0.045em;
    max-width: 17ch; text-wrap: balance;
  }
  .hero-sub { margin-top: 20px; font-size: clamp(17px, 1.4vw, 20px); line-height: 1.55; max-width: 52ch; }
  .hero-stats {
    display: grid; gap: 0; margin-top: clamp(28px, 3.5vw, 48px);
    border-top: 1px solid var(--borde);
  }
  .hero-stats li { display: flex; flex-direction: column; gap: 4px; padding: 16px 0; border-bottom: 1px solid var(--borde); }
  .hs-v { font: 700 clamp(28px, 3vw, 44px)/1 var(--f-sans); letter-spacing: -0.04em; }
  .hs-k { font: 400 15px/1.4 var(--f-sans); color: var(--gris-700); }
  @media (min-width: 768px) {
    .hero-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 30px; border-bottom: 1px solid var(--borde); }
    .hero-stats li { border-bottom: 0; }
  }
  .hero-press { margin-top: 12px; color: var(--gris-700); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 28px; margin-top: 28px; }
  .hero-btns { display: flex; flex-wrap: wrap; gap: 10px; }
  .hero-social { display: flex; gap: 18px; }

  /* Tira de miniaturas (H4/H5): fila manual con scroll-snap, sin carrusel automático */
  .strip { margin-top: clamp(32px, 4vw, 56px); }
  .strip ul {
    display: flex; gap: 12px;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    margin-inline: calc(var(--gutter) * -1); padding: 14px var(--gutter);
  }
  .strip ul::-webkit-scrollbar { display: none; }
  .strip li { flex: none; scroll-snap-align: start; }
  .thumb { display: block; position: relative; }
  .thumb-img {
    display: block; width: 140px; height: 140px; border-radius: 8px; overflow: hidden;
    background: var(--neutro);
    transition: transform .3s var(--ease-p2);
  }
  .thumb-img :global(img), .thumb-img :global(svg) { width: 100%; height: 100%; object-fit: cover; }
  .thumb-label {
    display: block; margin-top: 8px;
    font: 500 13px/1.2 var(--f-sans); color: var(--gris-700);
  }
  .thumb::after {
    content: ''; position: absolute; left: 50%; bottom: 22px; width: 19px; height: 2px; margin-left: -9.5px;
    background: var(--violeta); opacity: 0; transition: opacity .3s;
  }
  @media (min-width: 1200px) {
    .strip ul {
      overflow: visible; margin: 0; gap: 15px; padding: 20px;
      background: rgba(17, 17, 17, 0.05);
      border-radius: 10px;
    }
    /* Todos los proyectos del portafolio: la fila se desplaza en horizontal dentro del panel. */
    .strip ul { overflow-x: auto; scrollbar-width: thin; scrollbar-color: rgba(17, 17, 17, 0.25) transparent; }
    .strip li { flex: none; width: 210px; }
    .thumb-img { width: 100%; height: 150px; border-radius: 6px; }
    .thumb-label {
      position: absolute; left: 10px; bottom: 10px; margin: 0;
      padding: 6px 10px; border-radius: var(--pill);
      background: rgba(255, 255, 255, 0.94); color: var(--tinta); font-weight: 600;
      opacity: 0; transform: translateY(4px);
      transition: opacity .3s var(--ease-p2), transform .3s var(--ease-p2);
    }
    .thumb::after { bottom: -10px; }
    .thumb:hover .thumb-img, .thumb:focus-visible .thumb-img { transform: translateY(-12px); }
    .thumb:hover .thumb-label, .thumb:focus-visible .thumb-label { opacity: 1; transform: translateY(-12px); }
    .thumb:hover::after, .thumb:focus-visible::after { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .thumb:hover .thumb-img, .thumb:focus-visible .thumb-img,
    .thumb:hover .thumb-label, .thumb:focus-visible .thumb-label { transform: none !important; }
  }
</style>
