---
import SocialIcon from '../SocialIcon.astro';
import Cover from '../Cover.astro';
import { ORDER, PROJECTS, PROJECT_ROUTE } from '../../i18n/portfolio';
import { r } from '../../i18n/routes';
import { LINKS, EMAIL, type Lang } from '../../config';
import { HOME } from '../../i18n/home';
import { emph } from '../../lib/util';
interface Props { lang: Lang }
const { lang } = Astro.props;
const h = HOME[lang].hero;
const ui = HOME[lang].ui;
const P = PROJECTS[lang];
// Mismas portadas, nombres y enlaces del portafolio; sin las herramientas pequeñas.
const ids = ORDER.filter((id) => !['metricas', 'espanol', 'dsa'].includes(id)).slice(0, 5);
// El nombre grande reutiliza el del eyebrow (texto antes del "·").
const name = h.eyebrow.split('·')[0].trim();
// La línea pequeña muestra solo el rol: el nombre ya va en grande debajo.
const role = h.eyebrow.split('·').slice(1).join('·').trim();
// "(internal data)" se separa para mostrarlo como nota al pie.
const split = (k: string) => { const m = k.match(/^(.*?)\s*(\([^)]*\))$/); return m ? [m[1], m[2]] : [k, '']; };
---
<section class="hero band-dark" aria-labelledby="hero-h1" data-dark>
  <div class="hero-float" aria-label={lang === 'es' ? 'Proyectos' : 'Projects'} role="group">
    {ids.map((id, i) => (
      <div class={`fc fc-${i + 1}`}>
        <div class="fc-scroll" data-fc-scroll>
          <div class="fc-drift">
            <a class="fc-card" href={r(PROJECT_ROUTE[id], lang)} aria-label={P[id].name} data-fc>
              <Cover id={id} lang={lang} alt={P[id].name} sizes="(min-width: 768px) 20vw, 36vw" eager={i < 2} />
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>

  <div class="wrap hero-copy">
    <p class="hero-eyebrow">{role}</p>
    <p class="hero-name" data-hero-name>{name}<span class="hn-dot" aria-hidden="true">.</span></p>
    <h1 id="hero-h1" class="hero-h1" set:html={emph(h.h1).replace(/e-commerce/g, '<span class="nw">e-commerce</span>')} />
    <p class="hero-sub">{h.sub}</p>
  </div>
</section>

<section class="proof band-dark" aria-label={lang === 'es' ? 'Resultados' : 'Results'}>
  <div class="wrap">
    <ul class="proof-stats">
      {h.stats.map((s) => {
        const [k, note] = split(s.k);
        return (
          <li data-fade>
            <span class="ps-v tnum">{s.v}{note && <span class="ps-ast" aria-hidden="true">*</span>}</span>
            <span class="ps-k">{k}{note && <span class="sr-only"> {note}</span>}</span>
          </li>
        );
      })}
    </ul>
    <div class="proof-foot">
      <p class="proof-note" aria-hidden="true">{lang === 'es' ? '* Datos internos de silBe' : '* Internal silBe data'}</p>
      <p class="proof-press">
        <a class="tlink under" href={LINKS.forbes} target="_blank" rel="noopener">{h.press} ↗<span class="sr-only"> {ui.newTab}</span></a>
      </p>
    </div>
    <nav class="proof-cta" aria-label={lang === 'es' ? 'Contacto y perfiles' : 'Contact and profiles'}>
      <a class="pc pc-pri" href={`mailto:${EMAIL}`} aria-label={ui.ctaLabel} data-cta="email-hero"><SocialIcon name="email" /><span>{h.primary}</span></a>
      <a class="pc" href={LINKS.linkedin} target="_blank" rel="noopener" aria-label={h.linkedinLabel} data-cta="linkedin-hero"><SocialIcon name="linkedin" /><span>LinkedIn</span></a>
      <a class="pc" href={LINKS.github} target="_blank" rel="noopener" aria-label={h.githubLabel} data-cta="github-hero"><SocialIcon name="github" /><span>GitHub</span></a>
      <a class="pc" href={LINKS.behance} target="_blank" rel="noopener" aria-label={`Behance ${ui.newTab}`} data-cta="behance-hero"><SocialIcon name="behance" /><span>Behance</span></a>
    </nav>
    <p class="proof-more"><a class="tlink" href={r('portfolio', lang)}>{h.secondary} →</a></p>
  </div>
</section>

<style>
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    /* La barra de estado (oscura en la home) completa el primer viewport. */
    min-height: calc(100svh - var(--topbar-h));
    display: flex; flex-direction: column; justify-content: center;
    padding-top: var(--header-h); padding-bottom: clamp(40px, 6vh, 72px);
  }

  /* ---------- Texto ---------- */
  .hero-copy { position: relative; z-index: 2; text-align: center; pointer-events: none; }
  .hero-copy a { pointer-events: auto; }
  .hero-eyebrow {
    font: 500 var(--t-xs)/1.4 var(--f-sans); letter-spacing: .12em; text-transform: uppercase;
    color: #fff;
  }
  .hero-name {
    margin-top: clamp(8px, 1.4vw, 20px);
    /* Una línea desde 1024: el tamaño se ajusta al ancho del nombre, no al clamp del spec (ver nota en el commit). */
    font: 400 clamp(64px, 10.6vw, 200px)/0.9 var(--f-logo); letter-spacing: -0.04em;
    color: var(--on-dark); white-space: nowrap;
    text-shadow: 0 2px 40px rgba(17, 17, 17, .55);
  }
  .hn-dot { color: var(--violeta); }
  @media (prefers-reduced-motion: no-preference) {
    .hero-name { animation: hn-in .8s var(--ease-out) .12s both; }
  }
  @keyframes hn-in { from { opacity: 0; } }
  /* "e-commerce" nunca se parte en dos líneas */
  .hero-h1 :global(.nw) { white-space: nowrap; }
  .hero-h1 {
    margin: clamp(20px, 2.4vw, 36px) auto 0; max-width: 34ch;
    font: 500 clamp(20px, 2vw, 28px)/1.3 var(--f-sans); letter-spacing: -0.02em;
    color: var(--on-dark); text-wrap: balance;
  }
  .hero-h1 :global(em.s) { color: inherit; }
  .hero-sub {
    margin: 14px auto 0; max-width: 52ch;
    font: 400 var(--t-base)/1.55 var(--f-sans); color: #fff; text-wrap: pretty;
  }
  @media (max-width: 1023px) { .hero-name { white-space: normal; } }

  /* ---------- Capa de portadas flotantes ---------- */
  .hero-float { position: absolute; inset: 0; z-index: 1; perspective: 1200px; }
  .fc { position: absolute; transform-style: preserve-3d; }
  .fc-scroll, .fc-drift { width: 100%; }
  .fc-card {
    position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden;
    border-radius: var(--r-img); background: #1d1d1f;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, .6);
    transition: transform .4s var(--ease-out), opacity .4s;
  }
  .fc-card :global(picture), .fc-card :global(img), .fc-card :global(svg), .fc-card :global(.cover-ph) { width: 100%; height: 100%; }
  .fc-card :global(img) { object-fit: cover; }
  .fc-card::after { content: ''; position: absolute; inset: 0; background: rgba(17, 17, 17, var(--shade, 0)); transition: background-color .3s; }
  .fc-card:hover::after, .fc-card:focus-visible::after { background: rgba(17, 17, 17, 0); }
  .fc-card:focus-visible { outline: 2px solid var(--on-dark); outline-offset: 4px; }
  @media (hover: hover) and (pointer: fine) { .fc-card:hover { transform: translateY(-6px); } }

  /* Escritorio: 2 arriba, 1 detrás del centro, 2 abajo */
  .fc-1 { left: 5%;  top: 9%;  width: 14vw; transform: translate3d(0, 0, -120px) rotateY(8deg); }
  .fc-2 { right: 7%; top: 6%;  width: 12vw; transform: translate3d(0, 0, -320px) rotateY(-6deg); }
  .fc-3 { left: 44%; top: 30%; width: 12vw; transform: translate3d(0, 0, -400px) rotateY(-3deg); opacity: .85; }
  .fc-4 { left: 10%; bottom: 4%; width: 16vw; transform: translate3d(0, 0, 40px) rotateY(6deg); }
  .fc-5 { right: 4%; bottom: 8%; width: 20vw; transform: translate3d(0, 0, 80px) rotateY(-8deg); }
  /* Las que quedan detrás del texto llevan un velo para que el contraste no baje de 4.5:1 */
  .fc-1, .fc-2, .fc-4, .fc-5 { --shade: .25; }
  .fc-3 { --shade: .55; }

  @media (max-width: 1023px) {
    .fc-1 { left: -4%; top: 12%; width: 26vw; }
    .fc-2 { right: -4%; top: 8%; width: 24vw; }
    .fc-3 { display: none; }
    .fc-4 { left: 6%; bottom: 4%; width: 26vw; }
    .fc-5 { right: -2%; bottom: 10%; width: 30vw; }
  }
  /* Móvil: 3 portadas como máximo, fuera del texto */
  @media (max-width: 767px) {
    .hero { justify-content: flex-start; padding-top: calc(var(--header-h) + 30vw); }
    .fc-1 { left: -6%; top: calc(var(--header-h) - 16px); width: 24vw; }
    .fc-2 { right: -5%; top: calc(var(--header-h) - 4px); width: 20vw; }
    .fc-4 { display: none; }
    .fc-5 { right: auto; left: 34%; top: auto; bottom: 2%; width: 34vw; }
  }

  /* Deriva lenta (solo con movimiento permitido) */
  @media (prefers-reduced-motion: no-preference) {
    .fc-drift { animation: fc-drift var(--d, 7s) ease-in-out infinite alternate; }
    .fc-1 { --d: 6s; } .fc-2 { --d: 8.5s; } .fc-3 { --d: 7.2s; } .fc-4 { --d: 9s; } .fc-5 { --d: 6.6s; }
  }
  @keyframes fc-drift { from { transform: translateY(-6px); } to { transform: translateY(6px); } }

  /* ---------- Franja de pruebas ---------- */
  .proof { padding-block: var(--sec-y); }
  /* Móvil: cifras un poco más pequeñas y con más aire entre bloques, para que cada una se lea como unidad. */
  .proof-stats { display: grid; gap: 44px; }
  @media (min-width: 768px) { .proof-stats { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 30px; } }
  /* Cifras centradas en su columna; todo el texto en blanco, la nota "(datos internos)" solo más pequeña. */
  .proof-stats li { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; }
  .ps-v { font: 400 40px/1 var(--f-logo); letter-spacing: -0.02em; color: #fff; }
  .ps-ast { font: 400 .5em/1 var(--f-sans); vertical-align: super; margin-left: 2px; color: #ffffffb3; }
  @media (min-width: 768px) { .ps-v { font-size: 48px; } }
  .ps-k { font: 400 var(--t-sm)/1.5 var(--f-sans); color: #fff; max-width: 32ch; }
  /* Pie de las cifras: la nota del asterisco y la fuente de Forbes. Centradas en móvil; en escritorio, nota a la izquierda y Forbes a la derecha. */
  .proof-foot { margin-top: clamp(36px, 3vw, 40px); display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; }
  .proof-note { font: 400 var(--t-xs)/1.5 var(--f-sans); color: #fff; }
  .proof-press { font: 400 var(--t-sm)/1.5 var(--f-sans); color: #fff; }
  @media (min-width: 768px) {
    .proof-foot { flex-direction: row; justify-content: space-between; align-items: baseline; text-align: left; }
    .proof-press { text-align: right; }
  }
  .proof-press .tlink { color: #fff; }
  .proof-press .tlink { font-weight: 500; }
  /* Fila de contacto: el correo manda (violeta); perfiles iguales entre sí, con su marca. */
  /* Móvil: el correo a todo el ancho; LinkedIn, GitHub y Behance debajo, en una fila de tres más pequeños. */
  .proof-cta {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px;
    margin: clamp(40px, 4.5vw, 64px) auto 0;
  }
  .proof-cta .pc-pri { grid-column: 1 / -1; }
  @media (max-width: 767px) {
    .proof-cta .pc:not(.pc-pri) { height: 44px; padding-inline: 8px; gap: 6px; font-size: 14px; }
    .proof-cta .pc:not(.pc-pri) :global(.si) { width: 15px; height: 15px; }
  }
  @media (min-width: 768px) { .proof-cta { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; max-width: 80%; } .proof-cta .pc-pri { grid-column: auto; } }
  .pc {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    height: 56px; padding-inline: 18px; border-radius: var(--pill);
    border: 1px solid #ffffff40; color: var(--on-dark);
    font: 500 var(--t-base)/1 var(--f-sans); letter-spacing: -0.01em;
    transition: background .25s var(--ease-out), color .25s var(--ease-out), border-color .25s var(--ease-out), transform .25s var(--ease-out);
  }
  .pc :global(.si) { width: 18px; height: 18px; flex: none; }
  .pc:hover, .pc:focus-visible { background: var(--on-dark); border-color: var(--on-dark); color: var(--tinta); transform: translateY(-2px); }
  .pc-pri { background: var(--violeta); border-color: var(--violeta); color: #fff; box-shadow: 0 10px 30px -10px #6d28d9cc; }
  .pc-pri:hover, .pc-pri:focus-visible { background: var(--violeta-hover); border-color: var(--violeta-hover); color: #fff; }
  .pc:focus-visible { outline: 2px solid var(--on-dark); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .pc, .pc:hover { transition: none; transform: none; } }
  .proof-more { margin-top: 18px; text-align: center; font: 500 var(--t-sm)/1.4 var(--f-sans); }
  .proof .tlink:hover, .proof .tlink:focus-visible { color: var(--on-dark); }
  .proof :focus-visible { outline-color: var(--on-dark); }
</style>
