---
import type { Lang } from '../../config';
import { PRESS, PRESS_UI } from '../../i18n/press';
import { r } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const T = PRESS_UI[lang];
const base = r('press', lang);
---
<section class="press" aria-label={T.stripAria}>
  <p class="wrap press-label"><a href={base} class="under">{T.strip}</a></p>
  <div class="pmarquee">
      <div class="ptrack">
        {[0, 1].map((copy) => (
          <ul aria-hidden={copy === 1 ? 'true' : undefined}>
            {PRESS.map((p) => (
              <li>
                <a href={`${base}#${p.id}`} tabindex={copy === 1 ? -1 : undefined} aria-label={copy === 1 ? undefined : `${p.outlet}: ${p.client}`}>
                  <img src={p.logo.src} alt="" width={Math.round(p.h * p.logo.width / p.logo.height)} height={p.h} style={`--h:${p.h}px`} loading="lazy" decoding="async" />
                </a>
              </li>
            ))}
          </ul>
        ))}
      </div>
  </div>
</section>

<style>
  /* Misma mecánica que la franja de clientes: logos en un solo gris, desfile infinito, pausa al pasar el mouse. */
  /* Igual que la franja de marcas: rótulo pequeño centrado encima y logos a todo el ancho. */
  .press { padding-block: clamp(36px, 5vw, 72px); }
  .press-label {
    text-align: center; margin-bottom: clamp(16px, 2vw, 28px);
    font: 500 var(--t-xs)/1.4 var(--f-sans); letter-spacing: .12em; text-transform: uppercase; color: var(--gris-500);
  }
  .press-label a { color: inherit; }
  .pmarquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .ptrack { display: flex; width: max-content; animation: press-scroll 36s linear infinite; }
  .pmarquee:hover .ptrack, .pmarquee:focus-within .ptrack { animation-play-state: paused; }
  .ptrack ul { display: flex; align-items: center; gap: clamp(48px, 6vw, 96px); padding-right: clamp(48px, 6vw, 96px); }
  .ptrack li { flex: none; display: flex; align-items: center; height: 64px; }
  .ptrack a { display: block; padding: 6px; border-radius: 6px; }
  .ptrack img { height: calc(var(--h) * .8); width: auto; filter: brightness(0); opacity: .6; transition: opacity 200ms var(--ease-out); }
  .ptrack a:hover img, .ptrack a:focus-visible img { opacity: 1; }
  @keyframes press-scroll { to { transform: translateX(-50%); } }
  @media (min-width: 768px) {
    .ptrack li { height: 80px; }
    .ptrack img { height: var(--h); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ptrack { animation: none; }
    .pmarquee { overflow-x: auto; scrollbar-width: none; }
  }
</style>
