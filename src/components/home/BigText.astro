---
import Btn from '../Btn.astro';
import type { Lang } from '../../config';
import { HOME } from '../../i18n/home';
import { emph } from '../../lib/util';
import { r } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const b = HOME[lang].big;
---
<section class="bigtext sec" aria-labelledby="big-h2">
  <div class="wrap">
    <h2 id="big-h2" class="big-title bt-h2" data-split-lines set:html={emph(b.h2)} />
    <div class="bt-body">
      <p class="bt-p support" data-fade>{b.body}</p>
      <div class="bt-btn" data-fade><Btn href={r('silbe', lang)} label={b.button} variant="dark" /></div>
    </div>
    <ol class="bt-steps" data-fade>
      {b.steps.map((s, i) => (
        <li><span class="bs-n tnum">0{i + 1}</span><span class="bs-t">{s.t}</span><span class="bs-d">{s.d}</span></li>
      ))}
    </ol>
  </div>
</section>

<style>
  .bigtext { padding-top: clamp(56px, 7vw, 110px); }
  .bt-h2 { max-width: 15em; }
  .bt-body {
    display: grid; gap: 28px; margin-top: clamp(28px, 3.5vw, 48px);
    align-items: end;
  }
  @media (min-width: 992px) { .bt-body { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: 30px; } }
  .bt-p {
    font-size: clamp(20px, 2vw, 28px); line-height: 1.4; letter-spacing: -0.02em; max-width: 34em;
  }
  .bt-btn { justify-self: start; }
  @media (min-width: 992px) { .bt-btn { justify-self: end; } }
  .bt-steps { display: grid; gap: 0; margin-top: clamp(36px, 4vw, 56px); }
  @media (min-width: 768px) { .bt-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 30px; } }
  @media (min-width: 1200px) { .bt-steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .bt-steps li { display: flex; flex-direction: column; gap: 6px; border-top: 1px solid var(--borde); padding: 16px 0; }
  .bs-n { font: 600 13px/1.3 var(--f-sans); color: var(--violeta); }
  .bs-t { font: 600 22px/1.2 var(--f-sans); letter-spacing: -0.03em; }
  .bs-d { font: 300 15px/1.5 var(--f-sans); color: var(--gris-700); }
</style>
