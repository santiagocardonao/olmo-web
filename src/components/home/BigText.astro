---
import Btn from '../Btn.astro';
import type { Lang } from '../../config';
import { HOME } from '../../i18n/home';
import { plain } from '../../lib/util';
import { r } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const b = HOME[lang].big;
// Título y cuerpo se leen como un solo bloque; cada palabra se enciende al pasar la línea de lectura.
// Un salto de línea en el cuerpo (\n) abre un párrafo nuevo dentro del bloque.
const lines = `${plain(b.h2)} ${b.body}`.split('\n').map((l) => l.trim().split(/\s+/));
/**
 * Íconos propios de los 4 pasos, trazo fino de 1.5 sobre 40×40, con un solo acento violeta:
 * hipótesis = embudo con la fuga; experimento = un camino que se parte en A y B;
 * instrumentación = señal con eventos marcados; decisión = dos caminos que se juntan en el ganador.
 */
const ICONS = [
  `<path d="M7 10h26l-9.5 11.5V30l-7 3V21.5Z"/><circle class="acc" cx="29.5" cy="25" r="1.7"/><circle class="acc soft" cx="32" cy="31" r="1.2"/>`,
  `<circle cx="8" cy="20" r="2.5"/><path d="M10.5 20c7 0 7-9 15.5-9"/><path d="M10.5 20c7 0 7 9 15.5 9"/><circle cx="29" cy="11" r="2.5"/><circle class="acc" cx="29" cy="29" r="2.5"/>`,
  `<path class="soft" d="M6 33h28" stroke-dasharray="1 3.2"/><path d="M6 25h5l3-7 4.5 11 4.5-16 3.5 12H34"/><circle class="acc" cx="22.5" cy="13" r="2"/>`,
  `<path class="soft" d="M6 12c7 0 8 8 14 8" stroke-dasharray="1.5 3"/><path d="M6 28c7 0 8-8 14-8h5"/><circle class="acc" cx="30" cy="20" r="5"/><path class="chk" d="m27.6 20.2 1.7 1.7 3.3-3.4"/>`,
];
---
<section class="stmt" aria-labelledby="big-h2">
  <div class="wrap">
    <h2 id="big-h2" class="sr-only">{plain(b.h2)}</h2>
    <p class="sr-only">{b.body}</p>
    <p class="stmt-text" aria-hidden="true" data-words>
      {lines.map((ws, i) => (
        <>{i > 0 && <span class="stmt-br" />}{ws.map((w) => <><span class="w">{w}</span>{' '}</>)}</>
      ))}
    </p>
    <ol class="stmt-steps" data-fade>
      {b.steps.map((s, i) => (
        <li><span class="ss-ic" aria-hidden="true"><svg viewBox="0 0 40 40" width="40" height="40" set:html={ICONS[i]} /></span><span class="ss-n tnum">0{i + 1}</span><span class="ss-t">{s.t}</span><span class="ss-d">{s.d}</span></li>
      ))}
    </ol>
    <div class="stmt-btn" data-fade><Btn href={r('silbe', lang)} label={b.button} variant="dark" /></div>
  </div>
</section>

<style>
  .stmt { padding-block: var(--sec-y) calc(var(--sec-y) * .5); }
  .stmt-text {
    margin-inline: auto; max-width: 900px; text-align: center;
    font: 500 clamp(28px, 3.6vw, 56px)/1.15 var(--f-sans); letter-spacing: -0.02em;
    color: var(--tinta); text-wrap: pretty;
  }
  .stmt-br { display: block; height: .6em; }
  .stmt-steps {
    display: grid; gap: 0; margin-top: clamp(56px, 7vw, 104px);
  }
  @media (min-width: 768px) { .stmt-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 30px; } }
  @media (min-width: 1200px) { .stmt-steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .stmt-steps li { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; padding: 22px 8px; }
  /* Baldosa del ícono: blanco que se tiñe de violeta muy suave hacia abajo, con un filo violeta casi invisible. */
  .ss-ic {
    display: grid; place-items: center; width: 72px; height: 72px; margin-bottom: 14px; border-radius: 20px;
    color: var(--tinta);
    background: linear-gradient(180deg, #fff, color-mix(in srgb, var(--violeta) 7%, #fff));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--violeta) 16%, transparent), 0 10px 24px -14px color-mix(in srgb, var(--violeta) 45%, transparent);
  }
  .ss-ic svg { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .ss-ic :global(.acc) { fill: var(--violeta); stroke: none; }
  .ss-ic :global(.soft) { opacity: .45; }
  .ss-ic :global(.chk) { stroke: #fff; stroke-width: 1.6; }
  .ss-n { font: 600 var(--t-xs)/1.3 var(--f-sans); color: var(--violeta); letter-spacing: .08em; }
  .ss-d { max-width: 26ch; }
  .ss-t { font: 500 var(--t-base)/1.3 var(--f-sans); color: var(--tinta); }
  .ss-d { font: 400 var(--t-sm)/1.5 var(--f-sans); color: var(--gris-700); }
  .stmt-btn { margin-top: clamp(28px, 3vw, 40px); display: flex; justify-content: center; }
</style>
