---
import Btn from '../Btn.astro';
import Cover from '../Cover.astro';
import { LINKS, type Lang } from '../../config';
import { HOME } from '../../i18n/home';
import { emph, link } from '../../lib/util';
import { r } from '../../i18n/routes';
import { PROJECT_ROUTE, type ProjectId } from '../../i18n/portfolio';
interface Props { lang: Lang; id?: string }
const { lang, id = lang === 'es' ? 'resultados' : 'results' } = Astro.props;
const w = HOME[lang].work;
const ui = HOME[lang].ui;
// Cada tarjeta usa la misma portada y el mismo enlace del portafolio
const PID = Object.fromEntries(Object.entries(PROJECT_ROUTE).map(([k, v]) => [v, k])) as Record<string, ProjectId>;
---
<section class="work sec" id={id} aria-labelledby="work-title">
  <div class="wrap work-wrap">
    <div class="work-title">
      <div class="work-title-inner">
        <h2 id="work-title" class="giant">
          <span class="wt-l1" set:html={emph(w.line1)} />
          <span class="wt-l2">{w.line2}</span>
        </h2>
      </div>
    </div>

    <ul class="work-collage">
      {w.cards.map((c, i) => (
        <li class={`wcard wc-${i + 1}`}>
          <a href={link(lang, c.href)} data-cursor={w.cursor} aria-label={`${c.name}: ${c.figure}. ${w.viewCase}`}>
            <div class="wc-media">
              <Cover id={PID[c.href]} lang={lang} alt={c.alt} sizes="(min-width: 1200px) 400px, (min-width: 768px) 46vw, 92vw" />
            </div>
            <div class="wc-bar">
              <span class="wc-head"><span class="wc-name">{c.name}</span><span class="wc-tag">{c.tag}</span></span>
              <span class="wc-fig">{c.figure}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <div class="work-foot">
      <Btn href={r('portfolio', lang)} label={w.button} variant="dark" />
      <a class="tlink small work-src" href={LINKS.forbes} target="_blank" rel="noopener">{w.source} ↗<span class="sr-only"> {ui.newTab}</span></a>
    </div>
  </div>
</section>

<style>
  .work-title { text-align: center; margin-bottom: clamp(32px, 5vw, 64px); }
  .work-title h2 { display: inline-flex; flex-direction: column; align-items: flex-start; }
  .wt-l1 { display: inline-flex; align-items: flex-start; gap: 10px; }
  .wt-l1 :global(em.s) {
    position: relative;
    font-size: clamp(22px, 2.9vw, 42px); line-height: 1; letter-spacing: -0.01em;
    margin-top: .35em; padding-left: 16px; white-space: nowrap;
  }
  .wt-l1 :global(em.s)::before {
    content: ''; position: absolute; left: 0; top: .42em; width: 8px; height: 8px; border-radius: 50%; background: var(--violeta);
  }
  .wt-l2 { padding-left: .6em; }
  /* En celular "con nombre" no cabe al lado de "Resultados": baja a su propia línea */
  @media (max-width: 767px) {
    .wt-l1 { flex-wrap: wrap; row-gap: 4px; }
    .wt-l1 :global(em.s) { order: 2; flex-basis: 100%; margin-top: 0; }
  }
  .work-title-inner { transform-origin: 50% 50%; }

  .work-collage { display: grid; gap: 40px 24px; }
  @media (min-width: 768px) { .work-collage { grid-template-columns: 1fr 1fr; } }
  .wcard a { display: block; }
  .wc-media {
    position: relative; aspect-ratio: 1; border-radius: var(--r-img); overflow: hidden;
    background: var(--neutro);
  }
  .wc-media > :global(picture), .wc-media > :global(svg), .wc-media > :global(img) { width: 100%; height: 100%; }
  .wc-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .wc-media :global(img), .wc-media :global(svg) { transition: transform .6s var(--ease-p2); }
  @media (hover: hover) and (pointer: fine) {
    .wcard a:hover .wc-media :global(img), .wcard a:hover .wc-media :global(svg) { transform: scale(1.04); }
  }
  .wc-bar {
    display: flex; flex-direction: column; gap: 6px;
    margin-top: 8px; padding: 16px 20px;
    background: var(--blanco); border-radius: var(--r-img);
  }
  .wc-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .wc-name { font: 500 20px/1.2 var(--f-sans); letter-spacing: -0.02em; }
  .wc-tag { font: 500 13px/1.2 var(--f-sans); color: var(--gris-500); text-align: right; }
  .wc-fig { font: 600 15px/1.4 var(--f-sans); color: var(--tinta); letter-spacing: -0.01em; }

  .work-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; margin-top: clamp(40px, 5vw, 72px); }
  .work-src { font-weight: 500; }

  @media (min-width: 1200px) {
    .work-collage {
      grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 30px; row-gap: 0;
      position: relative; z-index: 2; margin-top: -120px;
    }
    .wc-1 { grid-column: 1 / span 4; grid-row: 1; }
    .wc-2 { grid-column: 9 / span 4; grid-row: 1; margin-top: 200px; }
    .wc-3 { grid-column: 2 / span 4; grid-row: 2; margin-top: 40px; }
    .wc-4 { grid-column: 8 / span 3; grid-row: 2; margin-top: 300px; }
    .wc-5 { grid-column: 4 / span 4; grid-row: 3; margin-top: 60px; }
    .work-title { margin-bottom: 0; }
  }
  @media (min-width: 1200px) and (prefers-reduced-motion: no-preference) {
    .work-title { position: sticky; top: 30vh; z-index: 1; pointer-events: none; }
  }
  @media (min-width: 1200px) and (prefers-reduced-motion: reduce) {
    .work-collage { margin-top: 48px; }
  }
</style>
