---
import { EMAIL, type Lang } from '../../config';
import { HOME } from '../../i18n/home';
import { link } from '../../lib/util';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = HOME[lang].services;
---
<section id={lang === 'es' ? 'servicios' : 'services'} class="circ band-dark" aria-labelledby="svc-title" data-dark>
  <div class="wrap">
    <h2 id="svc-title" class="sec-label"><span class="n">(02)</span>{s.left}</h2>
    <ul class="circ-list" aria-label={s.aria}>
      {s.offer.map((it) => (
        <li class="circ-item">
          <a class="circ-link" href={link(lang, it.href)}>
            <span class="circ-ring">
              <svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="49.5" pathLength="1" data-ring /></svg>
              <span class="circ-label">{it.title}</span>
            </span>
            <span class="circ-cap">{it.kind} · <strong>{it.meta}</strong></span>
          </a>
        </li>
      ))}
    </ul>
    <p class="circ-foot">
      <a class="tlink" href={`mailto:${EMAIL}`} aria-label={`${s.marquee[0]}: ${HOME[lang].ui.ctaLabel}`} data-cta="email-services">{s.marquee.join(' · ')} →</a>
    </p>
  </div>
</section>

<style>
  .circ { padding-block: var(--sec-y); border-top: 1px solid var(--line-dark); --d: clamp(160px, 20vw, 320px); }
  .circ-list {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 16px;
    margin-top: clamp(32px, 4vw, 56px);
  }
  .circ-link { display: flex; flex-direction: column; align-items: center; gap: 18px; text-align: center; }
  .circ-ring { position: relative; display: grid; place-items: center; width: 100%; max-width: var(--d); aspect-ratio: 1; }
  .circ-ring svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .circ-ring circle {
    fill: transparent; stroke: #ffffff33; stroke-width: 1px; vector-effect: non-scaling-stroke;
    stroke-dasharray: 1; stroke-dashoffset: 0;
    transition: stroke .3s, fill .3s;
  }
  .circ-label {
    position: relative; padding: 0 14%;
    font: 400 clamp(16px, 1.6vw, 22px)/1.25 var(--f-sans); letter-spacing: -0.01em; color: #ffffffd9;
  }
  .circ-cap { max-width: 26ch; font: 400 var(--t-sm)/1.5 var(--f-sans); color: #ffffff8c; transition: color .3s; }
  .circ-cap strong { font-weight: 500; color: var(--on-dark); }
  .circ-link:hover circle, .circ-link:focus-visible circle { stroke: var(--violeta); fill: #ffffff05; }
  .circ-link:hover .circ-cap, .circ-link:focus-visible .circ-cap { color: var(--on-dark); }
  .circ-link:focus-visible { outline: none; }
  .circ-link:focus-visible .circ-ring { outline: 2px solid var(--on-dark); outline-offset: 6px; border-radius: 50%; }

  /* Escritorio: 4 círculos en fila que se solapan ~10 % del diámetro */
  @media (min-width: 992px) {
    .circ-list { display: flex; justify-content: center; gap: 0; }
    .circ-item { flex: none; width: var(--d); }
    .circ-item + .circ-item { margin-left: calc(var(--d) * -0.1); }
    .circ-ring { width: var(--d); }
    .circ-cap { padding-inline: 8%; }
  }
  .circ-foot { margin-top: clamp(40px, 5vw, 72px); text-align: center; font: 500 var(--t-sm)/1.5 var(--f-sans); color: var(--on-dark); }
  .circ-foot .tlink:hover, .circ-foot .tlink:focus-visible { color: var(--on-dark); }
  .circ-foot :focus-visible { outline-color: var(--on-dark); }
</style>
