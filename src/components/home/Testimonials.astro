---
/**
 * Testimonios. Basados en los publicados en Framer, pasados a singular (Santi) con aprobación de Santiago, 12 nov 2026.
 * El inglés es traducción. Sin fotos: las de Framer no eran de las personas; se muestran iniciales hasta tener fotos reales.
 */
import type { Lang } from '../../config';
import { emph } from '../../lib/util';
interface Props { lang: Lang }
const { lang } = Astro.props;
const es = lang === 'es';
const T = es
  ? { left: 'Referencias', title: 'Lo que dicen quienes *trabajaron* conmigo.', aria: 'Referencias de personas que trabajaron con Santiago' }
  : { left: 'References', title: 'From the people I *worked* with.', aria: 'References from people who worked with Santiago' };
const items = [
  { name: 'Esteban García', role: es ? 'Director de producto, silBe by Silvy' : 'Head of Product, silBe by Silvy',
    quote: es ? 'Llevo años trabajando con Santi. Siempre nos ha ido perfecto y nos ha acompañado en todo el crecimiento de la marca.'
              : "I've worked with Santi for years. It has always gone perfectly, and he's been with us through all of the brand's growth." },
  { name: 'Sara Bermúdez', role: 'CMO, Undergold',
    quote: es ? 'Ha sido un proceso sencillo. Hemos llevado un par de proyectos a distancia con Santi y siempre ha entregado a tiempo. ¡Recomendado!'
              : "It's been an easy process. We've run a couple of projects remotely with Santi, and he's always delivered on time. Highly recommended!" },
];
const initials = (n: string) => n.split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]).join('');
---
<section class="tm sec" aria-labelledby="tm-title">
  <div class="wrap">
    <p class="sec-label"><span class="n">(03)</span>{T.left}</p>
    <h2 id="tm-title" class="tm-title" data-split-lines set:html={emph(T.title)} />
    <ul class="tm-grid" aria-label={T.aria}>
      {items.map((it) => (
        <li class="tm-card" data-fade>
          <figure>
            <blockquote><p>{it.quote}</p></blockquote>
            <figcaption>
              <span class="tm-avatar" aria-hidden="true">{initials(it.name)}</span>
              <span class="tm-who"><b>{it.name}</b><span>{it.role}</span></span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tm-title {
    margin-top: clamp(24px, 3vw, 40px); max-width: 20em;
    font: 600 var(--t-2xl)/1.02 var(--f-sans); letter-spacing: -0.045em; text-wrap: balance;
  }
  .tm-grid { display: grid; gap: 16px; margin-top: clamp(32px, 4vw, 56px); }
  @media (min-width: 768px) { .tm-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; } }
  .tm-card figure { height: 100%; display: flex; flex-direction: column; justify-content: space-between; gap: 28px;
    padding: clamp(24px, 3vw, 40px); border-radius: var(--r-img); background: var(--blanco); }
  .tm-card blockquote p { position: relative; font: 500 var(--t-md)/1.45 var(--f-sans); letter-spacing: -0.015em; color: var(--tinta); text-wrap: pretty; }
  .tm-card blockquote p::before { content: '“'; display: block; font: 600 56px/0.6 var(--f-serif, serif); color: var(--violeta); margin-bottom: 10px; }
  .tm-card figcaption { display: flex; align-items: center; gap: 14px; }
  .tm-avatar { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%;
    background: var(--violeta-tinte); color: var(--violeta); font: 700 16px/1 var(--f-sans); letter-spacing: .02em; }
  .tm-who { display: flex; flex-direction: column; gap: 3px; }
  .tm-who b { font: 600 16px/1.3 var(--f-sans); }
  .tm-who span { font: 400 14px/1.4 var(--f-sans); color: var(--gris-700); }
</style>
