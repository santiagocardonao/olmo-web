---
/**
 * Portada de un proyecto del portafolio.
 * Usa src/assets/portadas/<id>.(jpg|png|webp) si existe; si no, una imagen del sitio o el logo de la marca.
 */
import { Picture } from 'astro:assets';
import Visual from './Visual.astro';
import type { Lang } from '../config';
import type { ProjectId } from '../i18n/portfolio';
import { IMG } from '../lib/images';
import balparaiso from '../assets/logos/balparaiso.png';
import miaplus from '../assets/logos/miaplus.png';
interface Props { id: ProjectId; lang: Lang; alt: string; sizes: string; eager?: boolean }
const { id, lang, alt, sizes, eager = false } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/portadas/*.{jpg,jpeg,png,webp}', { eager: true });
const own = Object.entries(files).find(([p]) => p.split('/').pop()!.replace(/\.\w+$/, '') === id)?.[1].default;
const photo: Partial<Record<ProjectId, ImageMetadata>> = { silbe: IMG.silbeWebApp, ilmin: IMG.ilminMexico, metricas: IMG.metricas, cotiza: IMG.cotiza };
const visual: Partial<Record<ProjectId, 'undergold' | 'ideal' | 'espanol' | 'dsa'>> = { undergold: 'undergold', ideal: 'ideal', espanol: 'espanol', dsa: 'dsa' };
const logo: Partial<Record<ProjectId, ImageMetadata>> = { balparaiso, miaplus };
const word: Partial<Record<ProjectId, string>> = { zafiro: 'ZAFIRO', vieli: 'vieli' };
const img = own ?? photo[id];
const pos: Partial<Record<ProjectId, string>> = { silbe: '75% 50%', metricas: '0 0', cotiza: '0 0' };
---
{img ? (
  <Picture src={img} alt={alt} widths={[400, 700, 1000]} sizes={sizes} formats={['avif']} fallbackFormat="webp"
    loading={eager ? 'eager' : 'lazy'} style={!own && pos[id] ? `object-position:${pos[id]}` : undefined} />
) : visual[id] ? (
  <Visual kind={visual[id]!} lang={lang} label={alt} />
) : (
  <span class="cover-ph" role="img" aria-label={alt}>
    {logo[id] ? <img src={logo[id]!.src} alt="" width={logo[id]!.width} height={logo[id]!.height} loading="lazy" /> : <b>{word[id]}</b>}
  </span>
)}
<style>
  .cover-ph { display: grid; place-items: center; width: 100%; height: 100%; background: var(--neutro); padding: 18%; }
  .cover-ph img { width: 100%; height: auto !important; max-height: 40%; object-fit: contain !important; }
  .cover-ph b { font: 700 clamp(28px, 3vw, 44px)/1 var(--f-sans); letter-spacing: -0.04em; }
</style>
