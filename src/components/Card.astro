---
/**
 * Tarjeta de proyecto, la misma en la home, en Trabajo y en IA:
 * portada 4:5, nombre, etiqueta y cifra. La portada va en el slot "media".
 * El slot por defecto queda fuera del enlace (sirve para enlaces extra, como "Código en GitHub").
 */
interface Props {
  href: string; name: string; tag?: string; figure?: string; text?: string;
  ariaLabel?: string; cursor?: string; vt?: string; external?: boolean; newTab?: string;
}
const { href, name, tag, figure, text, ariaLabel, cursor, vt, external = false, newTab = '' } = Astro.props;
---
<li class="card" data-fade>
  <a href={href} data-cursor={cursor} aria-label={ariaLabel}
    {...(external ? { target: '_blank', rel: 'noopener' } : {})}>
    <div class="card-media" style={vt}><slot name="media" /></div>
    <span class="card-name">{name}<span class="card-arrow" aria-hidden="true">{external ? '↗' : '→'}</span>{external && !ariaLabel && <span class="sr-only"> {newTab}</span>}</span>
    {tag && <span class="card-tag">{tag}</span>}
    {figure && <span class="card-fig">{figure.replace(/ %/g, ' %')}</span>}
    {text && <span class="card-text">{text}</span>}
  </a>
  <slot />
</li>

<style>
  .card a { display: block; transition: transform 160ms var(--ease-out); }
  .card a:active { transform: scale(.98); }
  .card-media { position: relative; aspect-ratio: 4 / 5; border-radius: var(--r-img); overflow: hidden; background: var(--neutro); }
  .card-media > :global(picture), .card-media > :global(svg), .card-media > :global(img) { width: 100%; height: 100%; }
  .card-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .card-media :global(img), .card-media :global(svg) { transition: transform 400ms var(--ease-p2); }

  .card-name { display: block; margin-top: 14px; font: 500 var(--t-md)/1.2 var(--f-sans); letter-spacing: -0.02em; }
  .card-arrow {
    display: inline-block; margin-left: 8px; color: var(--violeta);
    opacity: 0; transform: translateX(-4px); transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out);
  }
  .card-tag { display: block; margin-top: 4px; font: 400 var(--t-xs)/1.35 var(--f-sans); color: var(--gris-500); }
  .card-fig { display: block; margin-top: 8px; font: 500 var(--t-sm)/1.45 var(--f-sans); color: var(--tinta); }
  .card-text { display: block; margin-top: 8px; font: 400 var(--t-sm)/1.5 var(--f-sans); color: var(--gris-700); }

  @media (hover: hover) and (pointer: fine) {
    .card a:hover .card-media :global(img), .card a:hover .card-media :global(svg) { transform: scale(1.03); }
    .card a:hover .card-arrow { opacity: 1; transform: none; }
  }
  .card a:focus-visible .card-arrow { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .card a:hover .card-media :global(img), .card a:hover .card-media :global(svg) { transform: none; }
    .card a:active { transform: none; }
  }
</style>
