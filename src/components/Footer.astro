---
import Btn from './Btn.astro';
import LangSwitch from './LangSwitch.astro';
import { EMAIL, LINKS, type Lang } from '../config';
import { HOME } from '../i18n/home';
import { r, type RouteId } from '../i18n/routes';
import { emph } from '../lib/util';
interface Props { lang: Lang; route: RouteId | null }
const { lang, route } = Astro.props;
const f = HOME[lang].footer;
const ui = HOME[lang].ui;
const pillIds: RouteId[] = ['portfolio', 'tools', 'about', 'terms', 'privacy'];
---
<div class="ft-zone" data-dark>
<section class="cta sec" id={lang === 'es' ? 'contacto' : 'contact'} aria-labelledby="cta-title">
  <div class="wrap">
    <p class="cta-eyebrow">{f.eyebrow}</p>
    <h2 id="cta-title" class="big-title cta-title" data-split-lines set:html={emph(f.title)} />
    <div class="cta-btn" data-fade>
      <Btn href={`mailto:${EMAIL}`} label={f.button} ariaLabel={ui.ctaLabel} variant="light" data-cta="email-footer" />
      <Btn href={LINKS.linkedin} label="LinkedIn" variant="sec" external ariaLabel={`LinkedIn ${ui.newTab}`} data-cta="linkedin-footer" />
    </div>
  </div>
</section>

</div>

<footer class="site-footer band-dark" data-dark>
  <div class="wrap">
    <div class="ft-grid">
      <div class="ft-brand">
        <a class="ft-id" href={r('home', lang)} aria-label={ui.logoLabel}>
          <span class="logo-word ft-logo">olmo</span><span class="ft-name">{ui.logoName}</span>
        </a>
        <p class="ft-blurb">{HOME[lang].hero.sub}</p>
        <p class="ft-status"><span class="ft-dot" aria-hidden="true"></span>{f.eyebrow}</p>
      </div>
      <nav class="ft-col" aria-labelledby="ft-pages">
        <h2 id="ft-pages" class="ft-h">{f.colPages}</h2>
        <ul>
          {pillIds.map((id, i) => (
            <li><a href={r(id, lang)} aria-current={route === id ? 'page' : undefined}>{f.pills[i]}</a></li>
          ))}
          <li><a href={r('tools', lang)}>{f.tools.replace(/\s*→$/, '')}</a></li>
        </ul>
      </nav>
      <div class="ft-col">
        <h2 class="ft-h">{f.colElsewhere}</h2>
        <ul>
          <li><a href={LINKS.linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span><span class="sr-only"> {ui.newTab}</span></a></li>
          <li><a href={LINKS.github} target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span><span class="sr-only"> {ui.newTab}</span></a></li>
          <li><a href={LINKS.behance} target="_blank" rel="noopener">Behance <span aria-hidden="true">↗</span><span class="sr-only"> {ui.newTab}</span></a></li>
        </ul>
      </div>
      <div class="ft-col">
        <h2 class="ft-h">{f.colHello}</h2>
        <a class="ft-email" href={`mailto:${EMAIL}`} data-cta="email-footer-link">{EMAIL}</a>
        <p class="ft-data">
          {f.city}<span class="ft-clock" hidden><span aria-hidden="true"> · </span><time data-clock data-lang={lang}></time> {f.inCity}</span>
        </p>
      </div>
    </div>

    <div class="ft-bottom">
      <p class="ft-copy">{f.copyright}</p>
      <div class="ft-end">
        <LangSwitch lang={lang} route={route} />
        <a class="ft-top" href="#" aria-label={f.toTop}><span aria-hidden="true">↑</span></a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Bloque final morado: CTA + footer sobre un degradado radial, todo el texto en blanco. */
  .ft-zone {
    --borde-z: rgba(255, 255, 255, 0.22);
    position: relative; isolation: isolate;
    margin-top: clamp(48px, 6vw, 96px);
    border-radius: clamp(24px, 3vw, 40px) clamp(24px, 3vw, 40px) 0 0;
    background:
      radial-gradient(70% 90% at 18% 0%, #9f67ff 0%, rgba(159, 103, 255, 0) 60%),
      radial-gradient(60% 80% at 100% 100%, #4c1d95 0%, rgba(76, 29, 149, 0) 70%),
      radial-gradient(120% 120% at 50% 30%, #7c3aed 0%, #6d28d9 45%, #3b0a8f 100%);
    color: #fff;
    overflow: clip;
  }
  .ft-zone :global(em.s) { color: #fff; }
  .ft-zone :global(.small), .ft-zone :global(.support) { color: #fff; }
  .ft-zone :global(:focus-visible) { outline-color: #fff; }
  .ft-zone :global(.tlink:hover), .ft-zone :global(.tlink:focus-visible) { color: #fff; }
  .ft-zone :global(.pill) { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.35); color: #fff; }
  .ft-zone :global(a.pill:hover) { background: #fff; border-color: #fff; color: var(--violeta); }
  .ft-zone :global(a.pill[aria-current='page']) { background: #fff; color: var(--violeta); border-color: #fff; }
  .ft-zone :global(.lang) { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.35); }
  .ft-zone :global(.lang a) { color: #fff; }
  .ft-zone :global(.lang a:hover) { color: #fff; opacity: .75; }
  .ft-zone :global(.lang a[aria-current='true']) { background: #fff; color: var(--violeta); opacity: 1; }
  .ft-zone :global(::selection) { background: #fff; color: var(--violeta); }

  .cta { padding-block: clamp(72px, 9vw, 140px) clamp(56px, 7vw, 100px); }
  .cta-eyebrow { font: 500 16px/1.3 var(--f-sans); color: #fff; margin-bottom: 18px; }
  .cta-title { max-width: 16.5em; }
  .cta-btn { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 10px; }
  /* Escritorio: banda más baja y titular del mismo tamaño que los de sección. */
  @media (min-width: 992px) {
    .cta { padding-block: clamp(56px, 5vw, 80px) clamp(48px, 4.5vw, 72px); }
    .cta-title { font-size: var(--t-xl); line-height: 1.08; letter-spacing: -0.04em; }
    .cta-btn { margin-top: 28px; }
  }
  .ft-zone { border-radius: clamp(24px, 3vw, 40px) clamp(24px, 3vw, 40px) 0 0; }

  /* Pie oscuro en cuatro columnas, sin líneas divisorias: el espacio separa los grupos. */
  .site-footer { padding-block: clamp(56px, 7vw, 104px) 28px; }
  .ft-grid { display: grid; gap: 40px 30px; }
  @media (min-width: 768px) { .ft-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .ft-brand { grid-column: 1 / -1; } }
  @media (min-width: 1200px) { .ft-grid { grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr)); } .ft-brand { grid-column: auto; } }
  .ft-id { display: inline-flex; align-items: baseline; gap: 10px; color: var(--on-dark); }
  .ft-logo { font-size: 28px; }
  .ft-name { font: 500 var(--t-base)/1.2 var(--f-sans); }
  .ft-blurb { margin-top: 16px; max-width: 38ch; font: 400 var(--t-sm)/1.6 var(--f-sans); color: var(--on-dark-2); }
  .ft-status {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 20px;
    padding: 8px 14px; border-radius: var(--pill); border: 1px solid var(--line-dark);
    font: 500 var(--t-sm)/1.2 var(--f-sans); color: var(--on-dark);
  }
  .ft-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--online); box-shadow: 0 0 0 3px #16a34a33; }
  .ft-h { font: 500 var(--t-xs)/1.3 var(--f-sans); letter-spacing: .1em; text-transform: uppercase; color: var(--on-dark-3); margin-bottom: 16px; }
  .ft-col ul { display: grid; gap: 10px; }
  .ft-col a:not(.ft-email) { font: 400 var(--t-base)/1.4 var(--f-sans); color: var(--on-dark); opacity: .85; transition: opacity .2s; }
  .ft-col a:not(.ft-email):hover, .ft-col a:not(.ft-email):focus-visible, .ft-col a[aria-current='page'] { opacity: 1; text-decoration: underline; text-underline-offset: .2em; }
  .ft-email {
    display: inline-flex; align-items: center; max-width: 100%;
    padding: 9px 16px; border-radius: var(--pill);
    border: 1px solid #ffffff4d; background: var(--surface-dark-2, #ffffff0a);
    font: 500 13px/1.2 var(--f-sans); color: var(--on-dark); word-break: break-all;
    transition: background .25s, color .25s, border-color .25s;
  }
  .ft-email:hover, .ft-email:focus-visible { background: var(--on-dark); border-color: var(--on-dark); color: var(--tinta); }
  .ft-data { margin-top: 12px; font: 400 var(--t-sm)/1.5 var(--f-sans); color: var(--on-dark-2); }

  .ft-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-top: clamp(40px, 5vw, 72px); }
  .ft-copy { font: 400 var(--t-sm)/1.4 var(--f-sans); color: var(--on-dark-2); }
  .ft-end { display: flex; align-items: center; gap: 12px; }
  .site-footer :global(.lang) { background: #ffffff0a; border-color: var(--line-dark); }
  .site-footer :global(.lang a) { color: var(--on-dark); }
  .site-footer :global(.lang a[aria-current='true']) { background: var(--on-dark); color: var(--tinta); }
  .ft-top {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    border: 1px solid var(--line-dark); color: var(--on-dark); transition: background .25s, color .25s;
  }
  .ft-top:hover, .ft-top:focus-visible { background: var(--on-dark); color: var(--tinta); }
  .site-footer :focus-visible { outline-color: var(--on-dark); }
</style>
