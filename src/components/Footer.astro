---
import Btn from './Btn.astro';
import LangSwitch from './LangSwitch.astro';
import { wa, EMAIL, LINKS, WHATSAPP_DISPLAY, type Lang } from '../config';
import { HOME } from '../i18n/home';
import { r, type RouteId } from '../i18n/routes';
import { emph } from '../lib/util';
interface Props { lang: Lang; route: RouteId | null }
const { lang, route } = Astro.props;
const f = HOME[lang].footer;
const ui = HOME[lang].ui;
const pillIds: RouteId[] = ['advisory', 'portfolio', 'tools', 'about', 'terms', 'privacy'];
const letters = [...f.bigWord];
---
<div class="ft-zone" data-dark>
<section class="cta sec" aria-labelledby="cta-title">
  <div class="wrap">
    <p class="cta-eyebrow">{f.eyebrow}</p>
    <h2 id="cta-title" class="big-title cta-title" data-split-lines set:html={emph(f.title)} />
    <div class="cta-btn" data-fade>
      <Btn href={wa(lang, 'WA5')} label={f.button} ariaLabel={`${f.button} ${ui.newTab}`} variant="light" external data-cta="wa5-footer" />
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="wrap">
    <div class="ft-row ft-links">
      <div>
        <h2 class="ft-h">{lang === 'es' ? 'Enlaces' : 'Links'}</h2>
        <ul class="ft-pills">
          {pillIds.map((id, i) => (
            <li><a class="pill" href={r(id, lang)} aria-current={route === id ? 'page' : undefined}>{f.pills[i]}</a></li>
          ))}
        </ul>
        <a class="tlink ft-tools" href={r('tools', lang)}>{f.tools}</a>
      </div>
      <div class="ft-contact">
        <p class="ft-h">{f.emailLabel}</p>
        <a class="ft-email" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <p class="ft-data small">
          <a class="tlink" href={wa(lang, 'WA5')} target="_blank" rel="noopener">{f.whatsapp} {WHATSAPP_DISPLAY}<span class="sr-only"> {ui.newTab}</span></a>
          <span aria-hidden="true"> · </span>{f.city}<span class="ft-clock" hidden><span aria-hidden="true"> · </span><time data-clock data-lang={lang}></time> {f.inCity}</span>
        </p>
      </div>
    </div>

    <div class="ft-row ft-big">
      <a class="logo-word ft-logo" href={r('home', lang)} aria-label={ui.logoLabel}>olmo</a>
      <a class="ft-word" href={wa(lang, 'WA5')} target="_blank" rel="noopener" aria-label={f.bigLabel} data-stretch>
        {letters.map((ch) => (ch === ' ' ? <span class="sp" aria-hidden="true">&nbsp;</span> : <span class="ch" aria-hidden="true">{ch}</span>))}
      </a>
    </div>

    <div class="ft-row ft-bottom">
      <p class="small">{f.copyright}</p>
      <ul class="ft-social">
        <li><a class="pill" href={LINKS.linkedin} target="_blank" rel="noopener">LinkedIn ↗<span class="sr-only"> {ui.newTab}</span></a></li>
        <li><a class="pill" href={LINKS.github} target="_blank" rel="noopener">GitHub ↗<span class="sr-only"> {ui.newTab}</span></a></li>
        <li><a class="pill" href={LINKS.behance} target="_blank" rel="noopener">Behance ↗<span class="sr-only"> {ui.newTab}</span></a></li>
      </ul>
      <LangSwitch lang={lang} route={route} />
    </div>
  </div>
</footer>
</div>

<style>
  /* Bloque final morado: CTA + footer sobre un degradado radial, todo el texto en blanco. */
  .ft-zone {
    --borde-z: rgba(255, 255, 255, 0.22);
    position: relative; isolation: isolate;
    margin-top: clamp(48px, 6vw, 96px);
    border-radius: clamp(24px, 3vw, 40px) clamp(24px, 3vw, 40px) 0 0;
    background:
      radial-gradient(70% 90% at 18% 0%, #9f67ff 0%, rgba(159, 103, 255, 0) 60%),
      radial-gradient(60% 80% at 100% 100%, #4c1d95 0%, rgba(76, 29, 149, 0) 70%),
      radial-gradient(120% 120% at 50% 30%, #7c3aed 0%, #6d28d9 45%, #3b0a8f 100%);
    color: #fff;
    overflow: clip;
  }
  .ft-zone :global(em.s) { color: #fff; }
  .ft-zone :global(.small), .ft-zone :global(.support) { color: #fff; }
  .ft-zone :global(:focus-visible) { outline-color: #fff; }
  .ft-zone :global(.tlink:hover), .ft-zone :global(.tlink:focus-visible) { color: #fff; }
  .ft-zone :global(.pill) { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.35); color: #fff; }
  .ft-zone :global(a.pill:hover) { background: #fff; border-color: #fff; color: var(--violeta); }
  .ft-zone :global(a.pill[aria-current='page']) { background: #fff; color: var(--violeta); border-color: #fff; }
  .ft-zone :global(.lang) { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.35); }
  .ft-zone :global(.lang a) { color: #fff; }
  .ft-zone :global(.lang a:hover) { color: #fff; opacity: .75; }
  .ft-zone :global(.lang a[aria-current='true']) { background: #fff; color: var(--violeta); opacity: 1; }
  .ft-zone :global(::selection) { background: #fff; color: var(--violeta); }

  .cta { padding-block: clamp(72px, 9vw, 140px) clamp(56px, 7vw, 100px); }
  .cta-eyebrow { font: 500 16px/1.3 var(--f-sans); color: #fff; margin-bottom: 18px; }
  .cta-title { max-width: 16.5em; }
  .cta-btn { margin-top: 40px; }
  .site-footer { padding-bottom: 28px; }
  .ft-row { border-top: 1px solid var(--borde-z); }
  .ft-links {
    display: grid; gap: 40px; padding-block: 40px 56px;
  }
  @media (min-width: 992px) { .ft-links { grid-template-columns: 1fr 1fr; } }
  .ft-h { font: 600 16px/1.3 var(--f-sans); margin-bottom: 16px; letter-spacing: -0.01em; }
  .ft-pills { display: flex; flex-wrap: wrap; gap: 8px; max-width: 520px; }
  .ft-tools { display: inline-block; margin-top: 22px; font-size: 15px; }
  .ft-contact { justify-self: start; }
  @media (min-width: 992px) { .ft-contact { justify-self: end; text-align: right; } }
  .ft-email {
    display: inline-block;
    font: 400 clamp(28px, 3.6vw, 52px)/1.15 var(--f-sans);
    letter-spacing: -0.02em;
    text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .14em;
    text-decoration-color: rgba(255, 255, 255, 0.5);
    transition: text-decoration-color .3s;
    word-break: break-word;
  }
  .ft-email:hover { text-decoration-color: #fff; }
  .ft-data { margin-top: 14px; }
  .ft-big {
    display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap;
    padding-block: 40px 32px;
  }
  .ft-logo { font-size: clamp(44px, 4.5vw, 64px); padding-bottom: .1em; }
  .ft-word {
    display: inline-flex; align-items: flex-end;
    font: 700 clamp(52px, 12.5vw, 180px)/0.9 var(--f-sans);
    letter-spacing: -0.03em;
    padding-top: .25em;
  }
  .ft-word .ch { display: inline-block; transform-origin: 50% 100%; transition: transform .4s cubic-bezier(.39,.575,.565,1), opacity .3s; }
  .ft-word:focus-visible { outline-offset: 8px; }
  .ft-word .ch.on { opacity: .7; }
  @media (prefers-reduced-motion: reduce) {
    .ft-word { text-decoration: underline transparent 4px; text-underline-offset: .1em; }
    .ft-word:hover { text-decoration-color: #fff; }
  }
  .ft-bottom {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;
    padding-top: 22px;
  }
  .ft-social { display: flex; flex-wrap: wrap; gap: 8px; }
</style>
