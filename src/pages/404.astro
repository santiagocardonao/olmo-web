---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
---
<Base lang="en" route={null} title="Page not found | Santiago Cardona" description="This page doesn't exist or has moved.">
  <section class="nf">
    <div class="wrap">
      <p class="labels"><span>404</span><span aria-hidden="true">( ES · EN )</span></p>
      <h1 class="nf-title">This page <em class="s">doesn't exist</em>.</h1>
      <p class="support nf-p">It may have moved with the new site.</p>
      <p class="support nf-p" lang="es">Esta página no existe. Puede que se haya movido con el sitio nuevo.</p>
      <div class="nf-btns">
        <Btn href="/" label="Go to the homepage" />
        <Btn href="/es/" label="Ir al sitio en español" variant="sec" lang="es" />
      </div>
    </div>
  </section>
</Base>
<style>
  .nf { padding: calc(var(--header-h) + 60px) 0 80px; }
  .nf-title { margin-top: 40px; font: 700 clamp(48px, 8.4vw, 132px)/0.98 var(--f-sans); letter-spacing: -0.05em; }
  .nf-p { margin-top: 16px; font-size: 20px; }
  .nf-btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 32px; }
</style>
