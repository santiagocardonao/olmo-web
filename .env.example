# Copia a .env y ajusta. Las variables PUBLIC_* quedan en el HTML.
SITE_URL=https://olmo.agency
# true = sitio de pruebas: <meta robots noindex> + robots.txt con Disallow: /
# Al migrar a olmo.agency, ponlo en false.
PUBLIC_NOINDEX=false
# Contenedor de Google Tag Manager (GA4 se configura dentro de GTM). Vacío = sin GTM.
PUBLIC_GTM_ID=GTM-NF997GFC
