# Olmo · sitio estático (Astro) en SiteGround
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# www → olmo.agency (sin www)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# HTTPS siempre
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- 12 nov 2026: el sitio pasa a ser portafolio personal. Inglés en /, español en /es/ ---
# Casos que salieron del portafolio
RewriteRule ^(?:en/)?portfolio/(balparaiso|mia-plus|zafiro|vieli|sarabe|itaca)/?$ /portfolio/ [R=301,L]
RewriteRule ^portafolio/(balparaiso|mia-plus|zafiro|vieli|sarabe|itaca)/?$ /es/portafolio/ [R=301,L]
RewriteRule ^es/portafolio/(balparaiso|mia-plus|zafiro|vieli|sarabe|itaca)/?$ /es/portafolio/ [R=301,L]
# Inglés: /en/... → /...
RewriteRule ^en/?$ / [R=301,L]
RewriteRule ^en/diagnostic/?$ /advisory/ [R=301,L]
RewriteRule ^en/work/?$ /portfolio/ [R=301,L]
RewriteRule ^en/work/(silbe|undergold|ideal-team)/?$ /portfolio/$1/ [R=301,L]
RewriteRule ^en/(.+)$ /$1 [R=301,L]
# Español: rutas viejas en la raíz → /es/...
RewriteRule ^(portafolio|sobre-mi|herramientas|asesoria|mensualidad|terminos|privacidad)(/.*)?$ /es/$1$2 [R=301,L]
RewriteRule ^casos/?$ /es/portafolio/ [R=301,L]
RewriteRule ^casos/(silbe|undergold|ideal-team)/?$ /es/portafolio/$1/ [R=301,L]
RewriteRule ^diagnostico/?$ /es/asesoria/ [R=301,L]
# URLs de Framer
RewriteRule ^alianza/?$ /es/mensualidad/ [R=301,L]
RewriteRule ^como-trabajamos/?$ /es/asesoria/ [R=301,L]
RewriteRule ^agenda/?$ /es/asesoria/ [R=301,L]
RewriteRule ^contacto/?$ /es/#contacto [R=301,L,NE]
RewriteRule ^t[^/]{1,6}rminos-y-condiciones/?$ /es/terminos/ [R=301,L]
RewriteRule ^terminos-y-condiciones/?$ /es/terminos/ [R=301,L]
RewriteRule ^politica-privacidad/?$ /es/privacidad/ [R=301,L]
RewriteRule ^blog(/.*)?$ / [R=301,L]
RewriteRule ^pagos/?$ / [R=301,L]
</IfModule>

# Caché: los archivos de /_astro y /fonts llevan hash o no cambian
<IfModule mod_headers.c>
  <FilesMatch "\.(avif|webp|png|jpg|jpeg|svg|woff2|js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  # Precios: se comparten por link directo y no se indexan (también van en robots.txt y meta noindex).
  <If "%{REQUEST_URI} =~ m#^/(advisory|monthly|es/asesoria|es/mensualidad)(/|$)#">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Seguridad (revisión del 16 oct 2026). HSTS sin includeSubDomains: cotiza y metricas aún no fuerzan HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "DENY"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  # CSP en modo solo reporte: los hashes son los dos <script> en línea (GTM y no-anim). Si cambian, recalcular.
  # Tras una semana sin violaciones en la consola, cambiar a Content-Security-Policy.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'sha256-Qb1aArT/SgSgeNEOrLH2uZXfBNMzLxYwtsVa1Su9VuM=' 'sha256-q4AVQQWkK1GnfX1VkqdeYfc3oN5+Q56Qg9CafOLHibg=' https://www.googletagmanager.com https://us-assets.i.posthog.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://*.g.doubleclick.net https://www.google.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.g.doubleclick.net https://www.google.com https://us.i.posthog.com https://us-assets.i.posthog.com; font-src 'self'; frame-src https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>
